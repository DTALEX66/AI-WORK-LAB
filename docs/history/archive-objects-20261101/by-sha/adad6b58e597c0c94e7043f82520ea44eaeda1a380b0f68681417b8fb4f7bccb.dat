function Ensure-ParentDir {
    param([string]$Path)
    $parent = Split-Path -Parent $Path
    if (-not (Test-Path -LiteralPath $parent)) {
        if ($DryRun) {
            Write-Host "[预演] 新建目录: $parent" -ForegroundColor Cyan
        } else {
            New-Item -ItemType Directory -Force -Path $parent | Out-Null
        }
    }
}

$Log = @()
foreach ($m in $Mappings) {
    $src = Join-Path $Root $m.Source
    $dst = Join-Path $Root $m.Destination
    $status = '待处理'

    if (-not (Test-Path -LiteralPath $src)) {
        $status = '源不存在，跳过'
        Write-Warning "源不存在，跳过: $src"
    }
    elseif (Test-Path -LiteralPath $dst) {
        $status = '目标已存在，跳过，需人工合并'
        Write-Warning "目标已存在，跳过: $dst"
    }
    else {
        Ensure-ParentDir -Path $dst
        if ($DryRun) {
            Write-Host "[预演] 移动: $src -> $dst" -ForegroundColor Green
            $status = '预演成功'
        } else {
            Move-Item -LiteralPath $src -Destination $dst
            $status = '已移动'
        }
    }

    $Log += [pscustomobject]@{
        Source = $src
        Destination = $dst
        Status = $status
        Note = $m.Note
    }
}

$logPath = Join-Path $Root '_整理日志_E服务器_原始资料.csv'
if ($DryRun) {
    Write-Host "`n当前为预演模式，没有移动任何文件。" -ForegroundColor Yellow
    Write-Host "确认无误后，把脚本顶部 `$DryRun = `$true 改成 `$DryRun = `$false 再运行。" -ForegroundColor Yellow
} else {
    $Log | Export-Csv -Path $logPath -Encoding UTF8 -NoTypeInformation
    Write-Host "整理完成，日志已保存: $logPath" -ForegroundColor Green
}
