# 12 数据模型补充 SQL

```sql
CREATE TABLE IF NOT EXISTS metacognition_events (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  source_type TEXT NOT NULL,
  source_id INTEGER NOT NULL,
  self_confidence REAL NOT NULL,
  actual_performance REAL NOT NULL,
  confidence_gap REAL NOT NULL,
  reflection TEXT NOT NULL DEFAULT '',
  created_at TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS diagnostic_results (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  route_id INTEGER,
  unit_id INTEGER,
  diagnostic_type TEXT NOT NULL,
  prerequisite_score REAL NOT NULL DEFAULT 0,
  concept_score REAL NOT NULL DEFAULT 0,
  procedure_score REAL NOT NULL DEFAULT 0,
  application_score REAL NOT NULL DEFAULT 0,
  recommendation_json TEXT NOT NULL DEFAULT '{}',
  created_at TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS skill_tasks (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  title TEXT NOT NULL,
  target_skill TEXT NOT NULL,
  expected_output TEXT NOT NULL DEFAULT '',
  rubric_json TEXT NOT NULL DEFAULT '{}',
  difficulty INTEGER NOT NULL DEFAULT 3,
  related_cards_json TEXT NOT NULL DEFAULT '[]',
  created_at TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS skill_task_attempts (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  task_id INTEGER NOT NULL,
  output_text TEXT NOT NULL DEFAULT '',
  score REAL NOT NULL DEFAULT 0,
  feedback TEXT NOT NULL DEFAULT '',
  created_at TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS memory_assets (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  asset_type TEXT NOT NULL,
  title TEXT NOT NULL,
  path_or_url TEXT NOT NULL,
  source_type TEXT NOT NULL DEFAULT '',
  source_id INTEGER,
  metadata_json TEXT NOT NULL DEFAULT '{}',
  created_at TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS teach_back_sessions (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  source_type TEXT NOT NULL,
  source_id INTEGER NOT NULL,
  user_explanation TEXT NOT NULL,
  explanation_score REAL NOT NULL DEFAULT 0,
  gaps_json TEXT NOT NULL DEFAULT '[]',
  created_at TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS learning_evidence_packets (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  source_type TEXT NOT NULL,
  source_id INTEGER NOT NULL,
  evidence_json TEXT NOT NULL DEFAULT '{}',
  mastery_claim TEXT NOT NULL DEFAULT '',
  created_at TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS learner_profile (
  id INTEGER PRIMARY KEY CHECK (id = 1),
  preferred_modality TEXT NOT NULL DEFAULT 'mixed',
  best_learning_time TEXT NOT NULL DEFAULT '',
  average_focus_minutes INTEGER NOT NULL DEFAULT 25,
  forgetting_speed REAL NOT NULL DEFAULT 1.0,
  confidence_bias REAL NOT NULL DEFAULT 0,
  profile_json TEXT NOT NULL DEFAULT '{}',
  updated_at TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS consolidation_reports (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  report_type TEXT NOT NULL,
  summary TEXT NOT NULL,
  mastered_json TEXT NOT NULL DEFAULT '[]',
  weak_json TEXT NOT NULL DEFAULT '[]',
  merge_suggestions_json TEXT NOT NULL DEFAULT '[]',
  machine_candidates_json TEXT NOT NULL DEFAULT '[]',
  created_at TEXT NOT NULL
);
```
