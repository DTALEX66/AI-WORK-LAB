# 12 数据库 SQL

```sql
CREATE TABLE IF NOT EXISTS palace_spaces (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  title TEXT NOT NULL,
  domain TEXT NOT NULL DEFAULT '',
  description TEXT NOT NULL DEFAULT '',
  layout_type TEXT NOT NULL DEFAULT 'room_path',
  created_at TEXT NOT NULL,
  updated_at TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS palace_rooms (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  space_id INTEGER NOT NULL,
  title TEXT NOT NULL,
  room_type TEXT NOT NULL DEFAULT 'concept_room',
  theme TEXT NOT NULL DEFAULT '',
  order_index INTEGER NOT NULL DEFAULT 0,
  capacity INTEGER NOT NULL DEFAULT 12,
  x REAL NOT NULL DEFAULT 0,
  y REAL NOT NULL DEFAULT 0,
  width REAL NOT NULL DEFAULT 400,
  height REAL NOT NULL DEFAULT 300,
  created_at TEXT NOT NULL,
  updated_at TEXT NOT NULL,
  FOREIGN KEY(space_id) REFERENCES palace_spaces(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS palace_loci (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  room_id INTEGER NOT NULL,
  title TEXT NOT NULL,
  position_x REAL NOT NULL DEFAULT 0,
  position_y REAL NOT NULL DEFAULT 0,
  position_z REAL NOT NULL DEFAULT 0,
  anchor_type TEXT NOT NULL DEFAULT 'object',
  capacity INTEGER NOT NULL DEFAULT 1,
  stability_score REAL NOT NULL DEFAULT 1,
  created_at TEXT NOT NULL,
  updated_at TEXT NOT NULL,
  FOREIGN KEY(room_id) REFERENCES palace_rooms(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS palace_objects (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  locus_id INTEGER NOT NULL,
  object_type TEXT NOT NULL,
  source_card_id INTEGER,
  source_entity_id INTEGER,
  source_unit_id INTEGER,
  title TEXT NOT NULL,
  visual_anchor TEXT NOT NULL DEFAULT '',
  memory_hook TEXT NOT NULL DEFAULT '',
  importance REAL NOT NULL DEFAULT 0.5,
  mastery_level INTEGER NOT NULL DEFAULT 0,
  review_status TEXT NOT NULL DEFAULT 'active',
  created_at TEXT NOT NULL,
  updated_at TEXT NOT NULL,
  FOREIGN KEY(locus_id) REFERENCES palace_loci(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS palace_links (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  from_object_id INTEGER NOT NULL,
  to_object_id INTEGER NOT NULL,
  link_type TEXT NOT NULL DEFAULT 'related_to',
  strength REAL NOT NULL DEFAULT 0.5,
  created_at TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS palace_routes (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  space_id INTEGER NOT NULL,
  title TEXT NOT NULL,
  purpose TEXT NOT NULL DEFAULT '',
  route_type TEXT NOT NULL DEFAULT 'review',
  ordered_loci_json TEXT NOT NULL DEFAULT '[]',
  created_at TEXT NOT NULL,
  updated_at TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS palace_walk_events (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  route_id INTEGER,
  locus_id INTEGER,
  object_id INTEGER,
  recall_success INTEGER NOT NULL DEFAULT 0,
  elapsed_ms INTEGER NOT NULL DEFAULT 0,
  confidence INTEGER NOT NULL DEFAULT 3,
  created_at TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS palace_moves (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  object_id INTEGER NOT NULL,
  from_locus_id INTEGER,
  to_locus_id INTEGER,
  reason TEXT NOT NULL DEFAULT '',
  created_at TEXT NOT NULL
);
```


