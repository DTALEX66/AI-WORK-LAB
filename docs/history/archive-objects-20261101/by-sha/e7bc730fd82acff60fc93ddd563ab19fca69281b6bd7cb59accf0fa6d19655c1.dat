# 11 A线数据模型 SQL

## 第一阶段核心表

```sql
CREATE TABLE IF NOT EXISTS learning_routes (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  title TEXT NOT NULL,
  description TEXT NOT NULL DEFAULT '',
  goal TEXT NOT NULL DEFAULT '',
  status TEXT NOT NULL DEFAULT 'not_started',
  progress REAL NOT NULL DEFAULT 0,
  scope TEXT NOT NULL DEFAULT 'human_learning',
  review_status TEXT NOT NULL DEFAULT 'approved',
  created_by TEXT NOT NULL DEFAULT 'human',
  created_at TEXT NOT NULL,
  updated_at TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS learning_units (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  route_id INTEGER NOT NULL,
  title TEXT NOT NULL,
  summary TEXT NOT NULL DEFAULT '',
  order_index INTEGER NOT NULL DEFAULT 0,
  status TEXT NOT NULL DEFAULT 'not_started',
  target_mastery REAL NOT NULL DEFAULT 0.8,
  current_mastery REAL NOT NULL DEFAULT 0,
  created_at TEXT NOT NULL,
  updated_at TEXT NOT NULL,
  FOREIGN KEY(route_id) REFERENCES learning_routes(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS knowledge_cards (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  unit_id INTEGER,
  title TEXT NOT NULL,
  front TEXT NOT NULL,
  back TEXT NOT NULL,
  card_type TEXT NOT NULL DEFAULT 'qa',
  source_document_id INTEGER,
  source_chunk_id INTEGER,
  entity_id INTEGER,
  difficulty INTEGER NOT NULL DEFAULT 3,
  scope TEXT NOT NULL DEFAULT 'human_learning',
  review_status TEXT NOT NULL DEFAULT 'candidate',
  trust_level TEXT NOT NULL DEFAULT 'unknown',
  created_by TEXT NOT NULL DEFAULT 'human',
  created_at TEXT NOT NULL,
  updated_at TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS review_events (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  card_id INTEGER NOT NULL,
  rating INTEGER NOT NULL,
  elapsed_ms INTEGER NOT NULL DEFAULT 0,
  confidence INTEGER NOT NULL DEFAULT 3,
  reviewed_at TEXT NOT NULL,
  FOREIGN KEY(card_id) REFERENCES knowledge_cards(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS memory_strength (
  card_id INTEGER PRIMARY KEY,
  stability REAL NOT NULL DEFAULT 0,
  difficulty REAL NOT NULL DEFAULT 0,
  due_at TEXT,
  last_reviewed_at TEXT,
  review_count INTEGER NOT NULL DEFAULT 0,
  lapse_count INTEGER NOT NULL DEFAULT 0,
  mastery_level INTEGER NOT NULL DEFAULT 0,
  FOREIGN KEY(card_id) REFERENCES knowledge_cards(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS mistake_records (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  card_id INTEGER,
  unit_id INTEGER,
  mistake_type TEXT NOT NULL,
  user_answer TEXT NOT NULL DEFAULT '',
  correct_answer TEXT NOT NULL DEFAULT '',
  reason TEXT NOT NULL DEFAULT '',
  fix_plan TEXT NOT NULL DEFAULT '',
  resolved INTEGER NOT NULL DEFAULT 0,
  created_at TEXT NOT NULL,
  resolved_at TEXT,
  FOREIGN KEY(card_id) REFERENCES knowledge_cards(id) ON DELETE SET NULL,
  FOREIGN KEY(unit_id) REFERENCES learning_units(id) ON DELETE SET NULL
);
```


