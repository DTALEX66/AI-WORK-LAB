"类型AST/方言/版本，不执行任意JS","domain":"Source / Document / Version / Anchor","phase":"D","themes":["black","white","cosmic"],"proposal":true},{"id":"UI-061","family":"内容与编辑阅读","name":"CanvasBoard / CanvasReferences","status":"复用","basis":"CanvasBoard","behavior":"节点/边/布局/资源往返","domain":"Source / Document / Version / Anchor","phase":"B","themes":["black","white","cosmic"],"proposal":true},{"id":"UI-062","family":"证据核验与研究","name":"FidelityCheckPanel","status":"复用","basis":"CheckPanel","behavior":"recognition_fidelity与具体任务/版本","domain":"Check / Claim / Evidence / Research","phase":"B","themes":["black","white","cosmic"],"proposal":true},{"id":"UI-063","family":"证据核验与研究","name":"ProfessionalBasisPanel","status":"复用","basis":"CheckPanel","behavior":"professional_basis，执行与判断分开","domain":"Check / Claim / Evidence / Research","phase":"B","themes":["black","white","cosmic"],"proposal":true},{"id":"UI-064","family":"证据核验与研究","name":"HumanRecognitionPanel","status":"改造","basis":"候选流程","behavior":"真人身份/范围/理由/版本与撤回","domain":"Check / Claim / Evidence / Research","phase":"B","themes":["black","white","cosmic"],"proposal":true},{"id":"UI-065","family":"证据核验与研究","name":"CheckDimensionBadges","status":"新增","basis":"CheckPanel标签","behavior":"保存/识别/依据/认可独立","domain":"Check / Claim / Evidence / Research","phase":"B","themes":["black","white","cosmic"],"proposal":true},{"id":"UI-066","family":"证据核验与研究","name":"EvidenceAnchorCard / SourceLocator","status":"改造","basis":"锚点列表/Reader","behavior":"source/version/page/region/time/block","domain":"Check / Claim / Evidence / Research","phase":"B","themes":["black","white","cosmic"],"proposal":true},{"id":"UI-067","family":"证据核验与研究","name":"ClaimEvidenceWorkbench","status":"新增","basis":"CAP-0030/知识页","behavior":"支持/反证/多源/不确定","domain":"Check / Claim / Evidence / Research","phase":"B","themes":["black","white","cosmic"],"proposal":true},{"id":"UI-068","family":"证据核验与研究","name":"EvidenceReviewQueue","status":"新增","basis":"现有候选/核验","behavior":"按对象版本审核","domain":"Check / Claim / Evidence / Research","phase":"B","themes":["black","white","cosmic"],"proposal":true},{"id":"UI-069","family":"证据核验与研究","name":"ResearchQuestion / LiteratureResult","status":"未来","basis":"F06研究适配","behavior":"标题/摘要/全文/授权原文分开","domain":"Check / Claim / Evidence / Research","phase":"D","themes":["black","white","cosmic"],"proposal":true},{"id":"UI-070","family":"证据核验与研究","name":"ResearchBundle / ExperimentRecord","status":"未来","basis":"F06","behavior":"问题/方法/环境/输入/反证/产物","domain":"Check / Claim / Evidence / Research","phase":"D","themes":["black","white","cosmic"],"proposal":true},{"id":"UI-071","family":"人类学习与教学","name":"LearningQueue / StudyPlan","status":"改造","basis":"学习页/learning_items","behavior":"目标/队列/due，计划不等于掌握","domain":"Assessment / LearningEvent / Course","phase":"C","themes":["black","white","cosmic"],"proposal":true},{"id":"UI-072","family":"人类学习与教学","name":"AssessmentQuestion","status":"新增","basis":"assessment.question藏回执","behavior":"真实题目正常呈现与版本","domain":"Assessment / LearningEvent / Course","phase":"C","themes":["black","white","cosmic"],"proposal":true},{"id":"UI-073","family":"人类学习与教学","name":"AnswerComposer","status":"改造","basis":"answer textarea","behavior":"独立作答、恢复、提交状态","domain":"Assessment / LearningEvent / Course","phase":"C","themes":["black","white","cosmic"],"proposal":true},{"id":"UI-074","family":"人类学习与教学","name":"HintDisclosure / BasisDrawer","status":"新增","basis":"图目标/需补合同","behavior":"提示使用事件；提交后才揭依据","domain":"Assessment / LearningEvent / Course","phase":"C","themes":["black","white","cosmic"],"proposal":true},{"id":"UI-075","family":"人类学习与教学","name":"ObjectiveFeedback / Rubric","status":"新增","basis":"F04","behavior":"客观结果、准则版本与不确定","domain":"Assessment / LearningEvent / Course","phase":"C","themes":["black","white","cosmic"],"proposal":true},{"id":"UI-076","family":"人类学习与教学","name":"SelfRatingButtons / ScheduleReceipt","status":"改造","basis":"rating/learning_review","behavior":"自评独立；幂等eventID与真实next_due","domain":"Assessment / LearningEvent / Course","phase":"C","themes":["black","white","cosmic"],"proposal":true},{"id":"UI-077","family":"人类学习与教学","name":"TeachBack / TransferTask","status":"未来","basis":"F04","behavior":"讲解准则、迁移题、多次表现","domain":"Assessment / LearningEvent / Course","phase":"D","themes":["black","white","cosmic"],"proposal":true},{"id":"UI-078","family":"人类学习与教学","name":"MasteryEvidence / Misconception","status":"未来","basis":"F04","behavior":"unassessed/insufficient_evidence","domain":"Assessment / LearningEvent / Course","phase":"D","themes":["black","white","cosmic"],"proposal":true},{"id":"UI-079","family":"人类学习与教学","name":"CourseLibrary / CourseOutline","status":"未来","basis":"F05/CoursePackage","behavior":"版本、目标、依赖、资源与恢复","domain":"Assessment / LearningEvent / Course","phase":"D","themes":["black","white","cosmic"],"proposal":true},{"id":"UI-080","family":"人类学习与教学","name":"LessonPlayer / LessonInteraction","status":"未来","basis":"F05/OpenMAIC选定模块","behavior":"隔离渲染、学习事件、文本/静态降级","domain":"Assessment / LearningEvent / Course","phase":"D","themes":["black","white","cosmic"],"proposal":true},{"id":"UI-081","family":"人类学习与教学","name":"VisualLessonStudio / AssetPanel","status":"未来","basis":"CAP-0060/0160","behavior":"场景/讲解/题目/资源与Core版本","domain":"Assessment / LearningEvent / Course","phase":"D","themes":["black","white","cosmic"],"proposal":true},{"id":"UI-082","family":"人类学习与教学","name":"SimulationControls / Results / ExperimentLog","status":"未来","basis":"F08","behavior":"参数、单位、方法、误差与实际结果","domain":"Assessment / LearningEvent / Course","phase":"D","themes":["black","white","cosmic"],"proposal":true},{"id":"UI-083","family":"AI资产与纠正","name":"MachineAnswerComposer / Readback","status":"复用","basis":"MachineAnswerPanel","behavior":"machine_answer任务与来源","domain":"MachineTask / Candidate / Asset / Evaluation","phase":"C","themes":["black","white","cosmic"],"proposal":true},{"id":"UI-084","family":"AI资产与纠正","name":"CorrectionDiff / CorrectionForm","status":"改造","basis":"已有局部纠正表单","behavior":"corrected_text/note，先候选","domain":"MachineTask / Candidate / Asset / Evaluation","phase":"C","themes":["black","white","cosmic"],"proposal":true},{"id":"UI-085","family":"AI资产与纠正","name":"CorrectionReview / ApprovalHistory","status":"新增","basis":"候选领域","behavior":"真人身份/版本/范围/理由","domain":"MachineTask / Candidate / Asset / Evaluation","phase":"C","themes":["black","white","cosmic"],"proposal":true},{"id":"UI-086","family":"AI资产与纠正","name":"IndependentRetest / EvaluationCompare","status":"新增","basis":"当前缺专用复测","behavior":"独立题集/模型/输入，审核不等于复测","domain":"MachineTask / Candidate / Asset / Evaluation","phase":"C","themes":["black","white","cosmic"],"proposal":true},{"id":"UI-087","family":"AI资产与纠正","name":"AiAssetRegistry / Detail","status":"改造","basis":"CanonicalKnowledgeSpace","behavior":"记忆/规则/技能、来源、评测、认可分开","domain":"MachineTask / Candidate / Asset / Evaluation","phase":"C","themes":["black","white","cosmic"],"proposal":true},{"id":"UI-088","family":"AI资产与纠正","name":"UsageReceipt / Drift / Revoke","status":"未来","basis":"F07","behavior":"使用/退化/撤回与历史保留","domain":"MachineTask / Candidate / Asset / Evaluation","phase":"D","themes":["black","white","cosmic"],"proposal":true},{"id":"UI-089","family":"AI资产与纠正","name":"OptionalTrainingExperiment","status":"未来","basis":"F07","behavior":"许可数据/资源/独立评测/回滚，非基础前置","domain":"MachineTask / Candidate / Asset / Evaluation","phase":"D","themes":["black","white","cosmic"],"proposal":true},{"id":"UI-090","family":"图谱与空间","name":"GlobalKnowledgeSearch / ResultPreview","status":"改造","basis":"CAP-0110/知识页","behavior":"关键词/语义、索引身份/范围/来源","domain":"GraphProjection / SpatialPackage","phase":"D","themes":["black","white","cosmic"],"proposal":true},{"id":"UI-091","family":"图谱与空间","name":"GraphExplorer / RelationshipInspector","status":"未来","basis":"F02/React Flow供体","behavior":"真实/推断关系分开，layout revision","domain":"GraphProjection / SpatialPackage","phase":"D","themes":["black","white","cosmic"],"proposal":true},{"id":"UI-092","family":"图谱与空间","name":"CanvasGroup / NodeCard / Connector","status":"改造","basis":"CanvasBoard/初版画布","behavior":"分组/类型/连线与对象引用","domain":"GraphProjection / SpatialPackage","phase":"D","themes":["black","white","cosmic"],"proposal":true},{"id":"UI-093","family":"图谱与空间","name":"CanvasToolbar / Minimap / AssetStrip","status":"新增","basis":"初版画布参考","behavior":"选择/拖动/缩放/键盘与资源","domain":"GraphProjection / SpatialPackage","phase":"D","themes":["black","white","cosmic"],"proposal":true},{"id":"UI-094","family":"图谱与空间","name":"SpatialPackageBrowser / LocusEditor","status":"未来","basis":"F09/CAP-0080/0160","behavior":"World/Room/Locus/Route和知识引用","domain":"GraphProjection / SpatialPackage","phase":"D","themes":["black","white","cosmic"],"proposal":true},{"id":"UI-095","family":"图谱与空间","name":"MemoryMap2D / TextFallback","status":"未来","basis":"F09","behavior":"同知识对象/路线/学习事件","domain":"GraphProjection / SpatialPackage","phase":"D","themes":["black","white","cosmic"],"proposal":true},{"id":"UI-096","family":"图谱与空间","name":"Scene2_5D / Scene3D","status":"未来","basis":"F09/Three/R3F","behavior":"坐标单位、布局版本、懒加载","domain":"GraphProjection / SpatialPackage","phase":"D","themes":["black","white","cosmic"],"proposal":true},{"id":"UI-097","family":"图谱与空间","name":"XrDevicePanel / ExternalPlayer","status":"未来","basis":"F13/Godot/OpenXR","behavior":"设备/输入/定位/发行独立验","domain":"GraphProjection / SpatialPackage","phase":"D","themes":["black","white","cosmic"],"proposal":true},{"id":"UI-098","family":"互通协同与恢复","name":"InteropProfilePicker / Qualification","status":"改造","basis":"交换/资料页","behavior":"平台×版本×功能×方向×样本","domain":"InteropProfile / Revision / Backup","phase":"B","themes":["black","white","cosmic"],"proposal":true},{"id":"UI-099","family":"互通协同与恢复","name":"ImportPreview / Mapping / LossReport","status":"改造","basis":"现有导入/交换任务","behavior":"外部ID/未知数据/损失透明","domain":"InteropProfile / Revision / Backup","phase":"B","themes":["black","white","cosmic"],"proposal":true},{"id":"UI-100","family":"互通协同与恢复","name":"ExportWizard / RoundtripReceipt","status":"改造","basis":"现有交换接线","behavior":"源软件真实打开，导出不是往返","domain":"InteropProfile / Revision / Backup","phase":"B","themes":["black","white","cosmic"],"proposal":true},{"id":"UI-101","family":"互通协同与恢复","name":"IncrementalSync / ConflictWorkbench","status":"未来","basis":"F03/F10","behavior":"基准revision/tombstone/撤销/重试","domain":"InteropProfile / Revision / Backup","phase":"D","themes":["black","white","cosmic"],"proposal":true},{"id":"UI-102","family":"互通协同与恢复","name":"BackupPanel / RestoreReceipt","status":"复用","basis":"BackupPanel/RecoveryShell","behavior":"SQLite/CAS/schema身份与独立副本恢复","domain":"InteropProfile / Revision / Backup","phase":"B","themes":["black","white","cosmic"],"proposal":true},{"id":"UI-103","family":"互通协同与恢复","name":"RecoveryShell / SafeMode","status":"复用","basis":"RecoveryShell/App","behavior":"保留错误原因、重试、日志、恢复、退出","domain":"InteropProfile / Revision / Backup","phase":"A","themes":["black","white","cosmic"],"proposal":true},{"id":"UI-104","family":"系统能力与边界","name":"CapabilityCatalog / Detail","status":"改造","basis":"CanonicalCapabilitiesSpace","behavior":"完整权威投影、前提/降级/下一步","domain":"Capability / Implementation / Policy","phase":"A","themes":["black","white","cosmic"],"proposal":true},{"id":"UI-105","family":"系统能力与边界","name":"ImplementationHealth / EngineReceipt","status":"复用","basis":"能力握手/Job","behavior":"声明≠执行≠引擎质量通过","domain":"Capability / Implementation / Policy","phase":"A","themes":["black","white","cosmic"],"proposal":true},{"id":"UI-106","family":"系统能力与边界","name":"ProviderModelSettings / OutboundScope","status":"未来","basis":"CAP-0150/F07/F11","behavior":"真实模型/出境范围/预算，不默认全库上传","domain":"Capability / Implementation / Policy","phase":"D","themes":["black","white","cosmic"],"proposal":true},{"id":"UI-107","family":"系统能力与边界","name":"WorkerManager / JobControls","status":"改造","basis":"活动/握手","behavior":"真实支持的取消/检查点/重试","domain":"Capability / Implementation / Policy","phase":"D","themes":["black","white","cosmic"],"proposal":true},{"id":"UI-108","family":"系统能力与边界","name":"PermissionBudget / ConnectionDetail","status":"未来","basis":"CAP-0130/0150","behavior":"Core策略，插件自声明不等于批准","domain":"Capability / Implementation / Policy","phase":"D","themes":["black","white","cosmic"],"proposal":true},{"id":"UI-109","family":"系统能力与边界","name":"PluginSkillLifecycle","status":"未来","basis":"F11","behavior":"manifest/禁用/升级/兼容/退出","domain":"Capability / Implementation / Policy","phase":"D","themes":["black","white","cosmic"],"proposal":true},{"id":"UI-110","family":"系统能力与边界","name":"Compatibility / Maintenance / ExportIdentity","status":"未来","basis":"F14","behavior":"供体revision/合同/NOTICE/迁出","domain":"Capability / Implementation / Policy","phase":"D","themes":["black","white","cosmic"],"proposal":true},{"id":"UI-111","family":"系统能力与边界","name":"Preferences / Accessibility","status":"新增","basis":"旧偏好/新Tokens","behavior":"主题/密度/语言/减少运动持久化","domain":"Capability / Implementation / Policy","phase":"A","themes":["black","white","cosmic"],"proposal":true}]}, css="/* AAOS 三主题迁移草案；不是已安装组件库。黑色沿新React；白色/深空沿旧ThemePalette。 */\n:root[data-aaos-theme=\"black\"] {\n  color-scheme: dark;\n  --aaos-background: #050505;\n  --aaos-sidebar: #0B0B0B;\n  --aaos-surface: #0B0B0B;\n  --aaos-raised: #121212;\n  --aaos-border: #3B4146;\n  --aaos-text: #F5F5F5;\n  --aaos-muted: #A5ADB3;\n  --aaos-primary: #F5F5F5;\n  --aaos-on-primary: #101214;\n  --aaos-gold: #B6AA8D;\n  --aaos-success: #22C55E;\n  --aaos-warning: #F59E0B;\n  --aaos-danger: #EF4444;\n  --aaos-info: #A5ADB3;\n  --aaos-selected: #292E32;\n  --aaos-focus: #F5F5F5;\n  --aaos-overlay: #99050505;\n}\n:root[data-aaos-theme=\"white\"] {\n  color-scheme: light;\n  --aaos-background: #F8F6EB;\n  --aaos-sidebar: #F0ECE1;\n  --aaos-surface: #FFFFFF;\n  --aaos-raised: #ECE8DD;\n  --aaos-border: #C8C2B4;\n  --aaos-text: #172033;\n  --aaos-muted: #586575;\n  --aaos-primary: #147F78;\n  --aaos-on-primary: #FFFFFF;\n  --aaos-gold: #9A6F21;\n  --aaos-success: #187A59;\n  --aaos-warning: #8A611C;\n  --aaos-danger: #B33A3A;\n  --aaos-info: #245FA8;\n  --aaos-selected: #D8EFEA;\n  --aaos-focus: #147F78;\n  --aaos-overlay: #66172033;\n}\n:root[data-aaos-theme=\"cosmic\"] {\n  color-scheme: dark;\n  --aaos-background: #081020;\n  --aaos-sidebar: #0C1728;\n  --aaos-surface: #101D2E;\n  --aaos-raised: #1A2233;\n  --aaos-border: #27516B;\n  --aaos-text: #F8F6EB;\n  --aaos-muted: #96AAB4;\n  --aaos-primary: #2EC4B6;\n  --aaos-on-primary: #081020;\n  --aaos-gold: #F4D08B;\n  --aaos-success: #37C99A;\n  --aaos-warning: #E6BE73;\n  --aaos-danger: #E56464;\n  --aaos-info: #3B82F6;\n  --aaos-selected: #173B47;\n  --aaos-focus: #2EC4B6;\n  --aaos-overlay: #9E081020;\n}\n:root { --aaos-radius-sm: 6px; --aaos-radius-md: 10px; --aaos-motion-fast: 140ms; --aaos-motion-panel: 200ms; }\n@media (prefers-reduced-motion: reduce) { :root { --aaos-motion-fast: 0ms; --aaos-motion-panel: 0ms; } }\n";
document.querySelector('#theme-code').textContent=css;
const rows=[...document.querySelectorAll('#catalog tbody tr')];
function filter(){const q=document.querySelector('#query').value.trim().toLowerCase(),s=document.querySelector('#status').value,p=document.querySelector('#phase').value;let n=0;for(const r of rows){r.hidden=!((!q||r.textContent.toLowerCase().includes(q))&&(!s||r.dataset.status===s)&&(!p||r.dataset.phase===p));if(!r.hidden)n++;}document.querySelector('#count').textContent=n+' / '+rows.length;}
for(const id of ['query','status','phase'])document.querySelector('#'+id).oninput=filter;filter();
function download(name,txt,type){const u=URL.createObjectURL(new Blob([txt],{type})),a=document.createElement('a');a.href=u;a.download=name;document.body.append(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(u),2000);}
document.querySelector('#download-registry').onclick=()=>download('AAOS_UI_Component_Proposal_20261006.json',JSON.stringify(spec,null,2),'application/json');
document.querySelector('#download-theme').onclick=()=>download('AAOS_Three_Theme_Tokens_Proposal.css',css,'text/css');
document.querySelector('#report-theme').onchange=e=>{const t=spec.themes[e.target.value],m={bg:'background',panel:'surface',raised:'raised',fg:'text',muted:'muted',border:'border',accent:'primary'};for(const[k,v]of Object.entries(m))document.documentElement.style.setProperty('--'+k,t[v]);document.documentElement.style.colorScheme=e.target.value==='white'?'light':'dark';};
const dialog=document.querySelector('#zoom'),zoomImg=document.querySelector('#zoom-image'),range=document.querySelector('#zoom-range');
for(const b of document.querySelectorAll('.image-open'))b.onclick=()=>{const im=b.querySelector('img');zoomImg.src=im.src;zoomImg.alt=im.alt;range.value='100';zoomImg.style.width='100%';dialog.showModal();};
range.oninput=()=>zoomImg.style.width=range.value+'%';document.querySelector('#close-zoom').onclick=()=>dialog.close();
</script></body></html>