# 09 数据库模型补充 SQL

```sql
CREATE TABLE IF NOT EXISTS mastery_archive (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  source_card_id INTEGER,
  source_unit_id INTEGER,
  title TEXT NOT NULL,
  canonical_summary TEXT NOT NULL,
  mastery_score REAL NOT NULL,
  mastery_level INTEGER NOT NULL,
  evidence_json TEXT NOT NULL DEFAULT '{}',
  publish_to_machine INTEGER NOT NULL DEFAULT 0,
  created_at TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS machine_knowledge_units (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  source_mastery_id INTEGER,
  unit_type TEXT NOT NULL,
  title TEXT NOT NULL,
  machine_statement TEXT NOT NULL,
  preconditions_json TEXT NOT NULL DEFAULT '[]',
  actions_json TEXT NOT NULL DEFAULT '[]',
  anti_patterns_json TEXT NOT NULL DEFAULT '[]',
  evidence_json TEXT NOT NULL DEFAULT '{}',
  confidence REAL NOT NULL DEFAULT 0,
  risk_level TEXT NOT NULL DEFAULT 'low',
  scope TEXT NOT NULL DEFAULT 'project_memory',
  status TEXT NOT NULL DEFAULT 'candidate',
  created_at TEXT NOT NULL,
  updated_at TEXT NOT NULL,
  FOREIGN KEY(source_mastery_id) REFERENCES mastery_archive(id) ON DELETE SET NULL
);

CREATE TABLE IF NOT EXISTS knowledge_translation_events (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  source_type TEXT NOT NULL,
  source_id INTEGER NOT NULL,
  target_type TEXT NOT NULL,
  target_id INTEGER,
  event_type TEXT NOT NULL,
  status TEXT NOT NULL,
  notes TEXT NOT NULL DEFAULT '',
  created_at TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS knowledge_conflicts (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  left_unit_id INTEGER NOT NULL,
  right_unit_id INTEGER NOT NULL,
  conflict_type TEXT NOT NULL,
  severity TEXT NOT NULL DEFAULT 'medium',
  resolution_status TEXT NOT NULL DEFAULT 'open',
  notes TEXT NOT NULL DEFAULT '',
  created_at TEXT NOT NULL
);
```


