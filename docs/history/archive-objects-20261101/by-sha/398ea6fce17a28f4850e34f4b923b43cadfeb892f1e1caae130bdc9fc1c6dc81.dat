<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>WORK-LAB · UI深化v2演示</title><style>
:root{color-scheme:dark;--bg:#0B1018;--side:#0E1520;--panel:#111C2B;--raised:#17263A;--line:#2C3B50;--text:#ECF2FA;--muted:#A4B2C6;--blue:#62A8FF;--bluebg:#193353;--green:#69D5B5;--greenbg:#173D37;--amber:#FFC878;--amberbg:#453626;--red:#FF9AAB;--redbg:#442832}
[data-theme=light]{color-scheme:light;--bg:#F3F6FA;--side:#fff;--panel:#fff;--raised:#EAF0F7;--line:#CBD5E1;--text:#172B46;--muted:#4F627A;--blue:#175BB9;--bluebg:#E4EEFF;--green:#146B53;--greenbg:#E2F4EA;--amber:#875309;--amberbg:#FFF0D2;--red:#AC304C;--redbg:#FCE7ED}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:14px/1.6 Inter,'Segoe UI','Microsoft YaHei',sans-serif}button,input,select,textarea{font:inherit}button{cursor:pointer;min-height:44px;padding:8px 15px;border-radius:7px;border:1px solid var(--line);background:var(--raised);color:var(--text)}button:hover{border-color:var(--blue)}button:disabled{opacity:.55;cursor:not-allowed}button.primary{color:var(--blue);background:var(--bluebg);border-color:var(--blue)}:focus-visible{outline:3px solid var(--blue);outline-offset:3px}input,select,textarea{width:100%;min-height:44px;background:var(--bg);color:var(--text);border:1px solid var(--line);border-radius:6px;padding:9px 12px}textarea{min-height:90px;resize:vertical}input[type=checkbox]{width:20px;min-height:20px;accent-color:var(--blue)}label{display:grid;gap:6px;color:var(--muted)}.check{display:flex;align-items:center;gap:10px;min-height:44px;color:var(--text)}label small,small{font-size:13px;color:var(--muted)}a{color:var(--blue)}h1{font-size:28px;line-height:1.35;margin:0 0 7px}h2{font-size:17px;line-height:1.45;margin:0 0 14px}h3{font-size:15px;margin:10px 0}p{margin:8px 0}.muted{color:var(--muted)}.shell{display:grid;grid-template-columns:216px minmax(0,1fr);min-height:100vh}.side{position:sticky;top:0;align-self:start;height:100vh;background:var(--side);border-right:1px solid var(--line);padding:24px 16px;display:flex;flex-direction:column;gap:18px}.brand{font-size:23px;font-weight:700;letter-spacing:1px}.side nav{display:grid;gap:7px}.side nav button{text-align:left;border:0;background:transparent;color:var(--muted)}.side nav button[aria-current=page]{background:var(--bluebg);color:var(--blue)}.side-bottom{margin-top:auto;font-size:13px;color:var(--muted)}.work{min-width:0}.top{padding:16px 28px;display:flex;justify-content:space-between;gap:12px;align-items:center;background:var(--side);border-bottom:1px solid var(--line)}.top input{max-width:340px}.content{padding:28px;max-width:1520px;margin:auto}.heading{display:flex;justify-content:space-between;gap:16px;align-items:start;margin-bottom:22px}.actions{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.grid{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(280px,1fr);gap:18px}.equal{grid-template-columns:repeat(2,minmax(0,1fr))}.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.panel{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:22px;min-width:0;margin-bottom:18px}.grid .panel{margin-bottom:0}.metric{font-size:29px;line-height:1.3;color:var(--blue);font-weight:600;margin:9px 0}.badge{display:inline-block;max-width:100%;padding:3px 10px;border-radius:5px;font-size:13px;color:var(--blue);background:var(--bluebg)}.badge.green{color:var(--green);background:var(--greenbg)}.badge.amber{color:var(--amber);background:var(--amberbg)}.badge.red{color:var(--red);background:var(--redbg)}.stack{display:grid;gap:16px}.fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.table-scroll{overflow:auto;max-width:100%;border-radius:6px}table{border-collapse:collapse;width:100%;min-width:650px;text-align:left}th{font-size:13px;color:var(--muted);background:var(--raised);font-weight:500}th,td{padding:14px 12px;border-bottom:1px solid var(--line);vertical-align:top}td:first-child{font-weight:600}td small{display:block;font-weight:400}.notice{padding:13px 16px;border-radius:7px;background:var(--bluebg);color:var(--blue);margin-bottom:18px}.notice.amber{background:var(--amberbg);color:var(--amber)}.notice.red{background:var(--redbg);color:var(--red)}.steps{display:flex;list-style:none;padding:0;gap:8px;margin:0 0 18px;flex-wrap:wrap}.steps li{padding:8px 12px;border:1px solid var(--line);border-radius:6px;color:var(--muted)}.steps .active{border-color:var(--blue);color:var(--blue)}.steps .done{color:var(--green)}.log{list-style:none;padding:0;margin:0;max-height:250px;overflow:auto}.log li{border-left:2px solid var(--line);margin:9px 0;padding:2px 0 2px 14px}.divider{border-top:1px solid var(--line);margin:16px 0}.row{display:flex;justify-content:space-between;gap:15px;margin:12px 0}.row span:last-child{text-align:right}details{margin:16px 0;color:var(--muted)}summary{cursor:pointer;min-height:44px;padding:10px 0}dialog{color:var(--text);background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:24px;width:min(680px,calc(100% - 28px));max-height:90vh;overflow:auto}dialog::backdrop{background:#03070dcc}dialog .actions{justify-content:end;margin-top:20px}.empty{padding:36px;text-align:center;color:var(--muted)}.toast{position:fixed;bottom:24px;right:24px;max-width:calc(100vw - 48px);padding:14px 18px;background:var(--raised);border:1px solid var(--blue);border-radius:8px;z-index:5}.skip{position:fixed;top:-100px;left:20px}.skip:focus{top:15px;background:var(--panel);padding:12px;z-index:8}.mobile-menu{display:none}.mono{font:13px/1.8 Consolas,monospace;overflow-wrap:anywhere}.bar{height:8px;background:var(--raised);border-radius:8px;margin:12px 0}.bar>span{display:block;height:100%;background:var(--blue);border-radius:8px}button.danger{color:var(--red)}.footer{padding:0 28px 24px;color:var(--muted);font-size:13px}.table-scroll:focus-visible{outline-offset:0}
@media(max-width:1199px){.shell{grid-template-columns:184px minmax(0,1fr)}.content,.top{padding:22px}.grid{grid-template-columns:minmax(0,1fr)}.cards{grid-template-columns:repeat(3,minmax(0,1fr))}.heading{flex-wrap:wrap}.brand{font-size:21px}}
@media(max-width:767px){.shell{display:block}.side{display:none;position:fixed;z-index:6;width:230px;box-shadow:0 0 0 100vmax #0008}.side.open{display:flex}.mobile-menu{display:block}.top{padding:12px 16px;flex-wrap:wrap}.top input{max-width:none;flex:1;min-width:130px}.content{padding:20px 16px}.cards,.fields,.equal{grid-template-columns:minmax(0,1fr)}h1{font-size:24px}.panel{padding:18px}.heading{margin-bottom:18px}.actions button{flex-grow:1}.footer{padding:0 16px 24px}.toast{left:16px;right:16px;bottom:16px;max-width:none}.row{flex-wrap:wrap}.row span:last-child{text-align:left}.top .badge{font-size:12px}.grid{gap:14px}}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;animation:none!important}}
</style></head><body><a class="skip" href="#main">跳到内容</a><div class="shell"><aside class="side" id="sidebar"><div><div class="brand">WORK-LAB</div><small>工作观测与能力适配</small></div><span class="badge amber">演示 · 未连接真实软件</span><nav aria-label="工作空间" id="nav"></nav><div class="side-bottom">本地工作空间<div class="divider"></div>Observer 观察者<br>管理操作另行校验<button data-action="reset" style="margin-top:12px">重置演示</button></div></aside><div class="work"><header class="top"><button class="mobile-menu" data-action="menu" aria-label="打开导航" aria-expanded="false">导航</button><span id="crumb">工作空间</span><div class="actions"><input id="search" type="search" placeholder="搜索项目与能力 · Ctrl K" aria-label="搜索项目与能力"><button data-action="theme">切换主题</button></div></header><main id="main" class="content" tabindex="-1"></main><footer class="footer">所有数据与操作结果均为本地演示。刷新后恢复样例，不读写原生软件，不发送任何材料。</footer></div></div><dialog id="modal" aria-labelledby="dialog-title"></dialog><div id="toast" role="status" aria-live="polite" hidden class="toast"></div><script>/* Local fixture simulation only; no production commands or backend authorization. */
(function(root){
'use strict';
const targets={hermes:{name:'Hermes · CLI',revision:'fixture-v1',qualified:true,loss:'缓存字段不支持'},qoder:{name:'Qoder · IDE',revision:'fixture-v1',qualified:false,loss:'更新后待复验'}};
function initial(){return {source:'demo:cap-01',sourceEvaluated:true,target:'',scope:'local:wl-01',epoch:0,trial:'idle',verification:'idle',deployment:'idle',authorization:false,lossAccepted:false,licenseReviewed:false,before:1,current:1,recovery:null,logs:[],operations:{}};}
function availability(s){const t=targets[s.target];const reasons=[];if(!s.sourceEvaluated)reasons.push('来源评价尚未推荐');if(!t)reasons.push('尚未选择目标');else if(!t.qualified)reasons.push('目标资格待复验');if(!s.licenseReviewed)reasons.push('许可与依赖待审查');if(!s.lossAccepted)reasons.push('损失待确认');if(s.trial!=='passed')reasons.push('隔离试用未通过');if(s.verification!=='passed')reasons.push('目标验证未通过');if(!s.authorization)reasons.push('演示管理权限未开启');if(s.before!==s.current)reasons.push('原生现态已变更');if(s.deployment!=='idle')reasons.push('已有发布或待恢复操作');return {allowed:reasons.length===0,reasons};}
function transition(s,a){let n={...s,logs:[...s.logs],operations:{...s.operations}};const log=t=>n.logs.push(t);switch(a.type){
case 'configure':if(s.deployment!=='idle')return s;n={...initial(),target:a.target??s.target,scope:a.scope??s.scope,source:a.source??s.source,sourceEvaluated:a.sourceEvaluated??s.sourceEvaluated,epoch:s.epoch+1,before:s.current,current:s.current};log('目标或范围变更，旧试用与验证已失效');break;
case 'license':n.licenseReviewed=!!a.value;break;
case 'loss':n.lossAccepted=!!a.value;break;
case 'authorization':n.authorization=!!a.value;break;
case 'trial_start':if(s.deployment!=='idle'||s.trial==='running'||!s.sourceEvaluated||!targets[s.target]?.qualified||!s.lossAccepted||!s.licenseReviewed)return s;n.trial='running';n.verification='idle';log('演示：已创建隔离试用；没有写入原生软件');break;
case 'trial_finish':if(a.epoch!==s.epoch||s.trial!=='running')return s;n.trial=a.ok?'passed':'failed';log(a.ok?'演示：3 个隔离样例通过':'演示失败：依赖出口不可用；未修改目标');break;
case 'trial_cancel':if(s.trial!=='running')return s;n.trial='cancelled';n.epoch++;log('隔离试用取消；晚到结果不再采用');break;
case 'verify':if(s.trial!=='passed'||s.deployment!=='idle')return s;n.verification=a.ok?'passed':'failed';log(a.ok?'演示：目标行为检查通过，绑定当前范围':'演示失败：目标未实际加载；修复后重验');break;
case 'external_edit':n.current++;log('演示：检测到用户在原生侧编辑');break;
case 'refresh_before':if(s.deployment!=='idle')return s;n.before=s.current;n.trial='idle';n.verification='idle';n.epoch++;log('重新读取前态，旧验证失效；需要再次试用');break;
case 'deploy':if(s.operations[a.key])return s;if(!a.key||!availability(s).allowed||a.expected!==s.current)return s;n.deployment='written';n.current++;n.recovery={baseline:s.current,published:n.current,scope:s.scope};n.operations[a.key]=true;log('演示：限定范围写入成功；加载与行为尚未确认');break;
case 'readback':if(s.deployment!=='written')return s;const readOk=a.ok&&s.current===s.recovery.published;n.deployment=readOk?'loaded':'readback_failed';log(readOk?'演示：读回与发布内容一致，等待行为确认':'演示：写入后读回不一致；保留证据，允许限定恢复');break;
case 'behavior':if(s.deployment!=='loaded')return s;const behaviorOk=a.ok&&s.current===s.recovery.published;n.deployment=behaviorOk?'verified':'behavior_failed';log(behaviorOk?'演示：发布行为检查通过':'演示：加载成功但行为未通过；允许限定恢复');break;
case 'recover':if(!s.recovery||!s.authorization||s.deployment==='restored'||s.deployment==='recovery_conflict')return s;if(s.current!==s.recovery.published){n.deployment='recovery_conflict';log('恢复冲突：用户现态发生改变，保留现态');}else{n.current++;n.deployment='restored';log('演示：仅恢复本次触及字段；恢复后加载与行为仍待复验');}break;
default:return s;}return n;}
function ratio(n,d){if(n===null||d===null)return {kind:'missing',value:null};if(d===0)return {kind:'not_computable',value:null};return {kind:'value',value:n/d};}
function mergeField(base,published,current,choice){if(current===base)return {kind:'auto',value:published};if(published===base||published===current)return {kind:'preserve',value:current};if(choice==='current')return {kind:'resolved',value:current};if(choice==='published')return {kind:'resolved',value:published};return {kind:'conflict',value:current};}
const api={targets,initial,availability,transition,ratio,mergeField};if(typeof module!=='undefined')module.exports=api;root.WLDemo=api;
})(typeof window==='undefined'?globalThis:window);
</script><script>'use strict';
const D=window.WLDemo,$=s=>document.querySelector(s),esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const badge=(t,tone='blue')=>`<span class="badge ${tone}">${esc(t)}</span>`;
const btn=(label,action,primary=false,disabled=false)=>`<button type="button" data-action="${action}" class="${primary?'primary':''}" ${disabled?'disabled':''}>${label}</button>`;
const panel=(title,body)=>`<section class="panel"><h2>${title}</h2>${body}</section>`;
const heads=(title,sub,actions='')=>`<div class="heading"><div><h1>${title}</h1><div class="muted">${sub}</div></div><div class="actions">${actions}</div></div>`;
const navItems=[['projects','项目监控'],['software','软件与环境'],['assets','能力资产'],['usage','用量与缓存'],['rules','规则与适配']];
const projectData=[{id:'local:wl-01',name:'WORK-LAB',soft:'Codex / Qoder',work:'运行 + 等待',health:'正常',obs:'部分延迟',tokens:'74.0 K',issue:true},{id:'local:dl-01',name:'DESIGN-LAB',soft:'Hermes',work:'等待输入',health:'正常',obs:'连通',tokens:'32.0 K',issue:false},{id:'local:aa-01',name:'ArcheAxis / AAOS',soft:'Codex',work:'本轮结束',health:'未知',obs:'仅历史',tokens:'20.0 K',issue:false}];
let selectedAssetId='demo:cap-01',page='projects',search='',filter=false,selectedProject=projectData[0],migration=D.initial(),trialTimer=null,trialKey=0,focusBefore=null,toastTimer;
let assets=[{id:'demo:cap-01',name:'技术回执检查',source:'Codex · fixture-r1',license:'样例许可已说明',evaluation:{verdict:'有条件推荐',task:'检查退出码与内容断言',notes:'只有 exit 0 时不能判为完成。',conditions:'本地技术回执；不替代专业验收'}}];
let onboard={step:0,software:'',fields:['project_id','token_summary'],written:false,readback:false,observed:false,failure:false};
let rule={base:7,published:3,current:14,choice:'',revision:1,previewRevision:null,authorization:false,result:'idle'};
const statusText={idle:'尚未开始',running:'进行中',passed:'通过',failed:'失败',cancelled:'已取消',written:'已写入 · 待读回',loaded:'已加载 · 待行为检查',readback_failed:'读回失败',behavior_failed:'行为未通过',verified:'演示行为通过',restored:'已限定恢复 · 待复验',recovery_conflict:'恢复冲突 · 保留现态'};
function notify(t){clearTimeout(toastTimer);$('#toast').textContent=t;$('#toast').hidden=false;toastTimer=setTimeout(()=>$('#toast').hidden=true,5000);}
function navigate(p){page=p;search='';$('#search').value='';$('#sidebar').classList.remove('open');document.querySelector('[data-action=menu]').setAttribute('aria-expanded','false');render();$('#main').focus();}
function render(){const focusId=document.activeElement?.id;const rootpage=['migration','asset'].includes(page)?'assets':['onboarding'].includes(page)?'software':page;$('#nav').innerHTML=navItems.map(([id,label])=>`<button data-nav="${id}" ${rootpage===id?'aria-current="page"':''}>${label}</button>`).join('')+`<button data-nav="diagnostics">按需诊断</button><button data-nav="settings">设置与隐私</button>`;$('#crumb').textContent='工作空间 / '+({migration:'能力迁移',asset:'能力详情',onboarding:'首次接入',project:selectedProject.name,diagnostics:'按需诊断',settings:'设置与隐私'}[page]||navItems.find(x=>x[0]===page)?.[1]);$('#main').innerHTML=views[page]();if(focusId&&focusId!=='main')document.getElementById(focusId)?.focus();}
const views={
projects(){const list=projectData.filter(x=>(!filter||x.issue)&&(`${x.name} ${x.id} ${x.soft}`).toLowerCase().includes(search.toLowerCase()));return heads('项目监控','查看参与软件、工作阻碍与最新可见状态')+`<div class="cards">${panel('参与项目','<div class="metric">3</div><small>2 个近期活动 · 1 个仅历史</small>')}${panel('需要关注','<div class="metric">1</div><small>Qoder 来源延迟</small>')}${panel('已知 Token 子集','<div class="metric">128.4 K</div><small>混合精度 · 费用未取得</small>')}</div>`+panel('项目活动',`<div class="actions">${btn(filter?'显示全部':'仅看需关注','filter')}</div><div class="table-scroll" tabindex="0" aria-label="项目活动表，可横向滚动"><table><thead><tr><th>项目 / 身份</th><th>参与软件</th><th>工作</th><th>健康</th><th>观测</th><th>操作</th></tr></thead><tbody>${list.map(x=>`<tr><td>${esc(x.name)}<small>${x.id}</small></td><td>${x.soft}</td><td>${badge(x.work)}</td><td>${badge(x.health,x.health==='未知'?'amber':'green')}</td><td>${badge(x.obs,x.obs==='连通'?'green':'amber')}</td><td><button data-project="${x.id}">查看详情</button></td></tr>`).join('')}</tbody></table></div>${!list.length?'<div class="empty">没有匹配项目；调整关键词或显示全部。</div>':''}`)+`<div class="grid equal">${panel('需要关注',`${badge('来源延迟','amber')}<h3>Qoder 最近摘要暂未更新</h3><p class="muted">源时间 17:37:08 · 收到时间 17:37:10<br>界面显示时间 17:40:12</p>${btn('查看诊断范围','diag')}`)}${panel('能力与规则','<p>1 项能力待目标验证 · 1 处配置冲突</p><div class="actions">'+btn('选择迁移目标','migration',true)+btn('处理规则冲突','rules')+'</div>')}</div>`;},
project(){const p=selectedProject;return heads(p.name,'项目身份 '+p.id)+`<div class="actions" style="margin-bottom:18px">${badge(p.work)}${badge('健康 '+p.health,p.health==='未知'?'amber':'green')}${badge('观测 '+p.obs,p.obs==='连通'?'green':'amber')}</div><div class="grid">${panel('参与软件',`<p>${p.soft}</p><p class="muted">目录身份与安装、运行、会话身份分别保留。</p>${btn('查看软件接入','software')}`)}${panel('用量摘要',`<div class="metric">${p.tokens}</div><p>已知 Token 子集</p><p class="muted">Credits 与费用未取得</p>`)}</div>`+panel('当前协作',`${badge('本地候选可用')}${badge('未发送','amber')}<p>AAOS 接收、知识决定、人的学习与效果均未取得。</p><p>DESIGN-LAB 教学工件与专业接受均未取得。</p><details><summary>查看责任与来源</summary>各方独立负责自己的版本与回执；技术候选不自动代表对端接受。</details>`);},
software(){return heads('软件与环境','资格按安装、形态、版本与字段分别判断',btn('接入新软件','onboarding',true))+panel('软件接入矩阵',`<div class="table-scroll" tabindex="0" aria-label="软件接入矩阵"><table><thead><tr><th>软件 / 形态</th><th>样例版本</th><th>观测状态</th><th>字段范围</th><th>资格</th></tr></thead><tbody><tr><td>Codex · CLI</td><td>fixture-v1</td><td>${badge('连通','green')}</td><td>项目活动 / Token / 缓存</td><td>样例范围通过</td></tr><tr><td>Qoder · IDE</td><td>fixture-v1</td><td>${badge('延迟','amber')}</td><td>项目活动 / 用量子集</td><td>更新后待复验</td></tr><tr><td>Hermes · CLI</td><td>fixture-v1</td><td>${badge('连通','green')}</td><td>项目活动 / Token</td><td>缓存不支持</td></tr><tr><td>DSH · 桌面</td><td>未取得</td><td>${badge('未接入','amber')}</td><td>未取得</td><td>待现场核对</td></tr></tbody></table></div><details><summary>接入资格如何判断？</summary>本页为合成样例。真实实施需核对原生出口、安装版本、鉴权方式与适配器版本，接通不代表拥有全部活动。</details>`);},
assets(){const list=assets.filter(x=>(x.name+' '+x.source).toLowerCase().includes(search.toLowerCase()));return heads('能力资产','先在来源评价，再选择目标进行适配',btn('导入能力记录','import',true))+panel('可用能力',`<div class="table-scroll" tabindex="0" aria-label="能力资产表"><table><thead><tr><th>能力 / 来源</th><th>来源评价</th><th>许可信息</th><th>操作</th></tr></thead><tbody>${list.map(x=>`<tr><td>${esc(x.name)}<small>${esc(x.source)}</small></td><td>${badge(x.evaluation?.verdict||'尚未评价',x.evaluation?'blue':'amber')}</td><td>${esc(x.license)}</td><td><div class="actions"><button data-asset="${esc(x.id)}" data-action="asset">查看 / 评价</button><button data-asset="${esc(x.id)}" data-action="migration">选择目标</button></div></td></tr>`).join('')}</tbody></table></div>${!list.length?'<div class="empty">没有匹配记录。可以清除关键词或导入来源信息。</div>':''}<details><summary>导入与部署有什么关系？</summary>此演示仅录入本地来源元数据，不解析能力包、不复制原生配置。真实导入需通过现有格式验证、许可审查和内容预览；导入后仍需单独验证与部署。</details>`);},
asset(){const a=assets.find(x=>x.id===selectedAssetId),e=a.evaluation;return heads(a.name,'来源 '+esc(a.source),btn('记录来源评价','evaluate',true,migration.source===selectedAssetId&&migration.deployment!=='idle')+btn('选择目标','migration'))+`<div class="grid equal">${panel('来源与许可',`<div class="row"><span>对象身份</span><span class="mono">${esc(a.id)}</span></div><div class="row"><span>许可</span><span>${esc(a.license)}</span></div><p class="muted">合成技术能力 · 不证明真实安装或效果</p>`)}${panel('来源评价',e?`${badge(e.verdict)}<h3>${esc(e.task)}</h3><p>${esc(e.notes)}</p><p class="muted">适用条件：${esc(e.conditions)}</p><small>用户判断与技术检查分别记录；此处为演示。</small>`:'尚未评价；填写样例任务、技术观察、用户判断及适用条件。')}</div>`;},
migration(){const s=migration,t=D.targets[s.target],av=D.availability(s),locked=s.deployment!=='idle';const progress=s.trial==='passed'?s.verification==='passed'?100:66:s.trial==='running'?33:0;return heads('能力迁移',esc(assets.find(x=>x.id===selectedAssetId).name)+' · 来源 '+esc(assets.find(x=>x.id===selectedAssetId).source),btn('返回能力详情','asset'))+`<div class="notice">演示流程 · 所有试用、写入、读回与恢复均在页面内模拟。</div><div class="grid">${panel('1. 选择目标与范围',`<div class="fields"><label>目标软件<select id="target" ${locked?'disabled':''}><option value="">请选择目标</option>${Object.entries(D.targets).map(([id,x])=>`<option value="${id}" ${s.target===id?'selected':''}>${x.name} · ${x.qualified?'样例范围合格':'待复验'}</option>`).join('')}</select></label><label>项目范围<select id="scope" ${locked?'disabled':''}><option value="local:wl-01" ${s.scope==='local:wl-01'?'selected':''}>WORK-LAB</option><option value="local:dl-01" ${s.scope==='local:dl-01'?'selected':''}>DESIGN-LAB</option></select></label></div><div class="divider"></div><p>${t?esc(t.loss):'选择后显示差异与损失。'}</p><label class="check"><input type="checkbox" id="license" ${s.licenseReviewed?'checked':''} ${locked?'disabled':''}>已审查演示许可与依赖</label><label class="check"><input type="checkbox" id="loss" ${s.lossAccepted?'checked':''} ${locked?'disabled':''}>接受当前目标的功能损失</label><details><summary>查看限定配置差异</summary><p class="mono">project_id: ${s.scope}<br>source_revision: ${esc(assets.find(x=>x.id===selectedAssetId).source)}<br>target_revision: ${t?.revision||'未选择'}<br>仅新增回执检查规则；不改变原生任务派发。</p></details>`)}${panel('发布条件',`<label class="check"><input id="authorization" type="checkbox" ${s.authorization?'checked':''}>模拟具备本范围管理权限</label><small>该开关仅用于演示，生产资格由后端返回。</small><ul>${av.reasons.map(x=>`<li>${esc(x)}</li>`).join('')||'<li>演示发布前提已齐备</li>'}</ul><div class="row"><span>预览前态</span><span>fixture-rev-${s.before}</span></div><div class="row"><span>当前现态</span><span>fixture-rev-${s.current}</span></div><div class="actions">${btn('模拟原生侧编辑','native-edit')}${btn('重新读取前态','refresh-before',false,locked)}</div>`)}</div><div style="height:18px"></div>`+panel('2. 隔离试用与目标验证',`<div class="row"><span>隔离试用 ${badge(statusText[s.trial],s.trial==='failed'?'red':'blue')}</span><span>目标验证 ${badge(statusText[s.verification],s.verification==='failed'?'red':'blue')}</span></div><div class="bar"><span style="width:${progress}%"></span></div><label>下一次试用结果<select id="trial-outcome"><option value="pass">样例通过</option><option value="fail">依赖出口不可用</option></select></label><div class="actions" style="margin-top:14px">${btn(s.trial==='failed'?'修复后重试':'启动隔离试用','trial',true,locked||s.trial==='running'||!s.sourceEvaluated||!t?.qualified||!s.lossAccepted||!s.licenseReviewed)}${btn('取消试用','cancel-trial',false,s.trial!=='running')}${btn('模拟目标验证通过','verify-pass',false,locked||s.trial!=='passed')}${btn('模拟目标加载失败','verify-fail',false,locked||s.trial!=='passed')}</div>${s.trial==='failed'?'<div class="notice red" style="margin-top:16px">依赖出口不可用。检查目标依赖后重试；本次没有写入原生目标。</div>':''}`)+panel('3. 发布、读回与恢复',`<p>${badge(statusText[s.deployment],s.deployment.includes('failed')||s.deployment==='recovery_conflict'?'red':'blue')}</p><div class="actions">${btn('模拟限定发布','deploy',true,!av.allowed)}${btn('模拟读回一致','readback-pass',false,s.deployment!=='written')}${btn('模拟读回失败','readback-fail',false,s.deployment!=='written')}${btn('模拟行为通过','behavior-pass',false,s.deployment!=='loaded')}${btn('模拟行为失败','behavior-fail',false,s.deployment!=='loaded')}${btn('恢复本次范围','recover',false,!s.recovery||!s.authorization||['restored','recovery_conflict'].includes(s.deployment))}</div><p class="muted">写入、原生加载、行为验证分别显示。恢复仅触及本次字段；遇到用户编辑先解决冲突。</p>`)+panel('操作记录',`<ol class="log">${s.logs.map(x=>`<li>${esc(x)}</li>`).join('')||'<li class="muted">尚未开始</li>'}</ol>`);},
onboarding(){const o=onboard;const names=['选择软件','选择字段','确认差异','验证接入'];let body='';if(o.step===0)body=`<label>软件与形态<select id="onboard-software"><option value="">请选择</option><option value="codex" ${o.software==='codex'?'selected':''}>Codex · CLI · fixture-v1</option><option value="qoder" ${o.software==='qoder'?'selected':''}>Qoder · IDE · 更新后待复验</option><option value="dsh" ${o.software==='dsh'?'selected':''}>DSH · 桌面 · 资格未取得</option></select></label><p>${o.software==='codex'?badge('演示资格覆盖最小字段','green'):badge('需核对原生出口与版本','amber')}</p>`;if(o.step===1)body=`<p>只启用所需字段；正文与工具载荷默认不采集。</p>${[['project_id','项目身份','归属与去重'],['token_summary','Token 摘要','已知用量字段'],['cache_summary','缓存摘要','样例支持读取与写入量']].map(([id,n,sub])=>`<label class="check"><input type="checkbox" data-field="${id}" ${o.fields.includes(id)?'checked':''}>${n}<small>${sub}</small></label>`).join('')}<label class="check"><input disabled type="checkbox">提示词 / 回复正文 <small>不在常态接入范围</small></label>`;if(o.step===2)body=`<div class="table-scroll" tabindex="0"><table><thead><tr><th>字段</th><th>前态</th><th>拟启用</th></tr></thead><tbody>${o.fields.map(x=>`<tr><td>${x}</td><td>未接入</td><td>限定项目 WORK-LAB</td></tr>`).join('')}</tbody></table></div><p>新增本方最小字段观测配置。保留原生任务与用户配置。</p><label class="check"><input type="checkbox" id="onboard-authorize">模拟授权本范围配置写入</label>`;if(o.step===3)body=`<div class="stack"><p>配置写入 ${badge(o.written?'演示写入成功':'未写入',o.written?'green':'amber')}</p><p>原生加载 ${badge(o.readback?'演示读回一致':o.failure?'读回失败':'待检查',o.readback?'green':o.failure?'red':'amber')}</p><p>最小字段样例 ${badge(o.observed?'演示字段已出现':'待样例活动',o.observed?'green':'amber')}</p><p class="muted">没有真实软件活动；以下按钮只用于查看接入状态。</p><div class="actions">${btn('模拟读回一致','onboard-read',true,o.readback)}${btn('模拟读回失败','onboard-fail',false,o.readback)}${btn('模拟样例活动','onboard-event',false,!o.readback||o.observed)}</div>${o.observed?'<div class="notice">演示范围通过。真实资格仍需实机观测与更新后复验。</div>':''}${o.failure?'<div class="notice red">原生未加载。检查路径与适配器后重试读回；不得重复写入，或清空原生配置。</div>':''}</div>`;return heads('首次接入','最小字段接入 · 不启动外部模型任务')+`<ol class="steps">${names.map((n,i)=>`<li class="${i===o.step?'active':i<o.step?'done':''}" ${i===o.step?'aria-current="step"':''}>${i+1}. ${n}</li>`).join('')}</ol>`+panel(names[o.step],body+`<div class="actions" style="margin-top:24px">${btn('上一步','onboard-back',false,o.step===0||o.written)}${o.step<3?btn(o.step===2?'模拟写入并继续':'下一步','onboard-next',true):btn('返回软件列表','software')}</div>`);},
usage(){return heads('用量与缓存','今日 · 已知子集 · 计量单位分别显示')+`<div class="cards">${panel('Token','<div class="metric">128.4 K</div><small>输入 100.0 K · 输出 28.4 K</small>')}${panel('缓存读取比例','<div class="metric">60%</div><small>30 K / 50 K · 完整可计算范围</small>')}${panel('可判断请求命中率','<div class="metric">40%</div><small>4 / 10 · 可判断请求</small>')}</div>`+panel('字段质量',`<div class="row"><span>输入精度</span><span>精确 83 K / 估算 17 K</span></div><div class="row"><span>缓存写入</span><span>0 Token · 样例真实报告零</span></div><div class="row"><span>Credits / 费用</span><span>未取得</span></div><div class="row"><span>全量请求基准</span><span>未取得 · 不计算覆盖率</span></div><details><summary>不同状态的数值如何展示？</summary>零值显示 0；缺失显示未取得；零分母显示不可计算；不同单位不相加。归属未知的 2.4 K Token 单列，合计仍为 128.4 K。</details>`);},
rules(){const r=rule;const merge=D.mergeField(r.base,r.published,r.current,r.choice);return heads('规则与适配','Hermes · demo-rules-r2 · 保留用户现态')+`<div class="notice ${r.result==='conflict'?'red':'amber'}">${r.result==='conflict'?'预览之后现态再次变化，合并已停止。':'retention_days 存在三方冲突，先选择处理方式。'}</div><div class="cards">${panel('前态',`<p class="mono">retention_days: ${r.base}</p><small>baseline-r1</small>`)}${panel('本方发布态',`<p class="mono">retention_days: ${r.published}</p><small>managed-r2</small>`)}${panel('原生现态',`<p class="mono">retention_days: ${r.current}</p><small>fixture-rev-${r.revision}</small>`)}</div>`+panel('限定合并方案',`<label>处理该字段<select id="merge-choice"><option value="">请选择</option><option value="current" ${r.choice==='current'?'selected':''}>保留用户现态 ${r.current}</option><option value="published" ${r.choice==='published'?'selected':''}>采用本方发布值 ${r.published}</option></select></label><p>其他字段与用户配置保留。</p><label class="check"><input id="rule-authorization" type="checkbox" ${r.authorization?'checked':''}>模拟具备当前规则范围管理权限</label><div class="actions">${btn('预览合并','merge-preview',true,!r.choice)}${btn('模拟用户继续编辑','rule-edit')}${btn('模拟提交限定合并','merge-apply',false,!r.authorization||r.previewRevision===null||merge.kind==='conflict')}</div>${r.previewRevision!==null?`<p>预览结果：retention_days = ${merge.value} · 前态 fixture-rev-${r.previewRevision}</p>`:''}${r.result==='applied'?'<div class="notice" style="margin-top:14px">演示限定合并已写入；原生加载与行为仍待验证。</div>':''}<details><summary>限定恢复如何操作？</summary>进入迁移页完成发布后，可以模拟读回失败与限定恢复。前态摘要不一致时必须保持现态，重新预览或人工合并。</details>`);},
diagnostics(){return heads('按需诊断','只查看所选问题与时间范围')+panel('诊断范围',`<div class="fields"><label>项目<select><option>WORK-LAB · local:wl-01</option></select></label><label>问题<select><option>Qoder 来源延迟</option></select></label><label>起始时间<input type="datetime-local" value="2026-10-09T17:30"></label><label>结束时间<input type="datetime-local" value="2026-10-09T17:40"></label></div><p class="muted">可见字段：项目身份、源时间、接收时间与活动摘要。私人正文与工具载荷不在范围。</p>${btn('预览范围内样例','diag-preview',true)}`)+panel('来源与缺口','<p>最新源时间 17:37:08 · 收到时间 17:37:10</p><p>最后正常摘要保留；历史读回支持情况未取得。</p><p class="muted">界面刷新不会产生新的源事件。</p>');},
settings(){return heads('设置与隐私','常态观测采用最小字段')+panel('默认范围','<p>项目身份、计量与去重字段：限定采集。</p><p>提示词、回复正文、工具载荷：默认不采集。</p><p>诊断：限定项目、问题、时间与保留期。</p><details><summary>停止采集和关闭窗口</summary>暂停滚动只影响阅读位置；关闭本方窗口与停止观测不能推断外部 AI 软件停止。实际壳行为由仓库既有生命周期合同决定。</details>')+panel('阅读与演示',`<div class="actions">${btn('切换主题','theme')}${btn('重置所有演示状态','reset')}</div><p class="muted">演示不持久化，不调用网络；真实权限、性能、原生配置需实机验收。</p>`);}
};
function openDialog(kind){focusBefore=document.activeElement;const a=assets.find(x=>x.id===selectedAssetId),e=a.evaluation;$('#modal').innerHTML=kind==='import'?`<form id="import-form"><h2 id="dialog-title">导入能力来源记录</h2><p class="muted">演示元数据录入；真实能力包解析与内容审查由现有导入服务完成。</p><div class="stack"><label>能力名称<input name="name" required maxlength="80"></label><label>来源 / 版本<input name="source" required maxlength="160" placeholder="本地来源名称 · revision"></label><label>许可信息<input name="license" required maxlength="180" placeholder="如未知，明确填写未取得"></label></div><p class="muted">同名来源记录显示重复；导入不自动部署。</p><div class="actions">${btn('取消','close')}<button type="submit" class="primary">导入演示记录</button></div></form>`:`<form id="evaluation-form"><h2 id="dialog-title">来源评价 · ${esc(a.name)}</h2><div class="stack"><label>样例任务<input name="task" required maxlength="180" value="${esc(e?.task||'')}"></label><label>技术观察<textarea name="notes" required maxlength="1000">${esc(e?.notes||'')}</textarea></label><label>用户判断<select name="verdict">${['有条件推荐','暂不推荐','尚不能判断'].map(v=>`<option ${e?.verdict===v?'selected':''}>${v}</option>`).join('')}</select></label><label>适用条件 / 限制<textarea name="conditions" required maxlength="1000">${esc(e?.conditions||'')}</textarea></label></div><p class="muted">保存的是用户评价，不能替代目标侧行为验证。</p><div class="actions">${btn('取消','close')}<button type="submit" class="primary">保存演示评价</button></div></form>`;$('#modal').showModal();}
function closeDialog(){$('#modal').close();focusBefore?.focus();}
function dispatch(type,extra={}){migration=D.transition(migration,{type,...extra});render();}
document.addEventListener('click',event=>{const b=event.target.closest('button');if(!b||b.disabled)return;if(b.dataset.nav)return navigate(b.dataset.nav);if(b.dataset.project){selectedProject=projectData.find(x=>x.id===b.dataset.project);return navigate('project');}const a=b.dataset.action;if(b.dataset.asset){if(b.dataset.asset!==selectedAssetId&&migration.deployment!=='idle')return notify('当前演示发布仍保留版本结果；请先重置演示再切换来源。');selectedAssetId=b.dataset.asset;if(migration.source!==selectedAssetId)migration=D.transition(migration,{type:'configure',source:selectedAssetId,sourceEvaluated:assets.find(x=>x.id===selectedAssetId).evaluation?.verdict==='有条件推荐'});}if(['software','assets','asset','migration','onboarding','rules'].includes(a))return navigate(a);switch(a){case 'menu':$('#sidebar').classList.toggle('open');b.setAttribute('aria-expanded',$('#sidebar').classList.contains('open'));break;case 'theme':document.documentElement.dataset.theme=document.documentElement.dataset.theme==='light'?'dark':'light';break;case 'filter':filter=!filter;render();break;case 'diag':navigate('diagnostics');break;case 'import':case 'evaluate':openDialog(a);break;case 'close':closeDialog();break;case 'trial':{const outcome=$('#trial-outcome').value;dispatch('trial_start');if(migration.trial!=='running')return;let epoch=migration.epoch;clearTimeout(trialTimer);trialTimer=setTimeout(()=>dispatch('trial_finish',{ok:outcome==='pass',epoch}),900);break;}case 'cancel-trial':clearTimeout(trialTimer);dispatch('trial_cancel');break;case 'verify-pass':case 'verify-fail':dispatch('verify',{ok:a==='verify-pass'});break;case 'deploy':dispatch('deploy',{key:'fixture-op-'+(++trialKey),expected:migration.before});break;case 'readback-pass':case 'readback-fail':dispatch('readback',{ok:a==='readback-pass'});break;case 'behavior-pass':case 'behavior-fail':dispatch('behavior',{ok:a==='behavior-pass'});break;case 'native-edit':dispatch('external_edit');break;case 'refresh-before':dispatch('refresh_before');break;case 'recover':dispatch('recover');break;case 'onboard-back':onboard.step=Math.max(0,onboard.step-1);render();break;case 'onboard-next':if(onboard.step===0&&onboard.software!=='codex')return notify('请选择已覆盖样例最小字段的软件；其他目标先完成资格核对。');if(onboard.step===1&&!onboard.fields.includes('project_id'))return notify('项目身份是归属前提，请选择项目身份字段。');if(onboard.step===2&&!$('#onboard-authorize').checked)return notify('本步骤的演示写入需要本范围授权开关。');if(onboard.step===2)onboard.written=true;onboard.step++;render();break;case 'onboard-read':onboard.readback=true;onboard.failure=false;render();break;case 'onboard-fail':onboard.failure=true;render();break;case 'onboard-event':onboard.observed=true;render();break;case 'merge-preview':rule.previewRevision=rule.revision;rule.result='preview';render();break;case 'rule-edit':rule.current++;rule.revision++;render();break;case 'merge-apply':if(!rule.authorization)return notify('演示管理权限未开启');if(rule.previewRevision!==rule.revision){rule.result='conflict';rule.previewRevision=null;}else{rule.current=D.mergeField(rule.base,rule.published,rule.current,rule.choice).value;rule.revision++;rule.previewRevision=null;rule.result='applied';}render();break;case 'diag-preview':{const inputs=[...document.querySelectorAll('input[type=datetime-local]')];if(inputs[0].value>inputs[1].value)return notify('结束时间必须晚于或等于起始时间。');notify('演示范围已选定；没有读取任何真实日志。');break;}case 'reset':clearTimeout(trialTimer);selectedAssetId='demo:cap-01';migration=D.initial();onboard={step:0,software:'',fields:['project_id','token_summary'],written:false,readback:false,observed:false,failure:false};rule={base:7,published:3,current:14,choice:'',revision:1,previewRevision:null,authorization:false,result:'idle'};assets=assets.slice(0,1);assets[0].evaluation={verdict:'有条件推荐',task:'检查退出码与内容断言',notes:'只有 exit 0 时不能判为完成。',conditions:'本地技术回执；不替代专业验收'};filter=false;navigate('projects');notify('已恢复演示样例');break;}});
document.addEventListener('change',e=>{const x=e.target;if(['target','scope'].includes(x.id)){clearTimeout(trialTimer);dispatch('configure',{[x.id]:x.value});}if(['license','loss','authorization'].includes(x.id))dispatch(x.id,{value:x.checked});if(x.id==='onboard-software'){onboard.software=x.value;render();}if(x.dataset.field){onboard.fields=x.checked?[...new Set([...onboard.fields,x.dataset.field])]:onboard.fields.filter(f=>f!==x.dataset.field);}if(x.id==='rule-authorization'){rule.authorization=x.checked;render();}if(x.id==='merge-choice'){rule.choice=x.value;rule.previewRevision=null;rule.result='idle';render();}});
document.addEventListener('submit',e=>{e.preventDefault();const f=e.target;if(!f.checkValidity())return f.reportValidity();const data=Object.fromEntries(new FormData(f));if(f.id==='import-form'){if(!data.name.trim()||!data.source.trim()||!data.license.trim())return notify('请填写有效的名称、来源和许可信息。');if(assets.some(x=>x.name===data.name.trim()&&x.source===data.source.trim()))return notify('该名称与来源版本已有记录；保留原记录，不重复导入。');assets.push({id:'demo:cap-'+(assets.length+1),name:data.name.trim(),source:data.source.trim(),license:data.license.trim(),evaluation:null});closeDialog();navigate('assets');notify('已导入演示元数据，尚未评价或部署');}if(f.id==='evaluation-form'){assets.find(x=>x.id===selectedAssetId).evaluation=data;migration=D.transition(migration,{type:'configure',source:selectedAssetId,sourceEvaluated:data.verdict==='有条件推荐'});closeDialog();render();notify('已记录演示用户评价');}});
$('#search').addEventListener('input',e=>{search=e.target.value;if(!['projects','assets'].includes(page)){page='projects';}render();});
document.addEventListener('keydown',e=>{if(e.isComposing||e.keyCode===229)return;if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='k'){e.preventDefault();$('#search').focus();}if(e.key==='Escape'){$('#sidebar').classList.remove('open');document.querySelector('[data-action=menu]').setAttribute('aria-expanded','false');}});
$('#modal').addEventListener('cancel',()=>setTimeout(()=>focusBefore?.focus(),0));render();
</script></body></html>
