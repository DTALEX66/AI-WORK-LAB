ags":null}},{"start_ix":3153,"end_ix":3165,"citation_format_type":"tether_v4","metadata":{"type":"webpage","title":"Galaxy: The Largest Open-Source UI Library You’ve Never Heard Of | Bright Coding","url":"https://www.blog.brightcoding.dev/2025/08/11/galaxy-the-largest-open-source-ui-library-you-ve-never-heard-of#:~:text=%2A%20Hand,copy%2C%20tweak%2C%20and%20redistribute%20freely","text":"* Hand-crafted by designers around the world. * Dual-format: delivered in vanilla CSS or Tailwind-ready classes. * MIT-licensed, so you can copy, tweak, and redistribute freely.","pub_date":null,"extra":{"cited_message_idx":10,"cited_message_id":"ed2503e1-1524-4b3c-9055-c0ad30472fd5","search_result_idx":null,"evidence_text":"","start_line_num":71,"end_line_num":73,"connector_source":null},"og_tags":null}},{"start_ix":3222,"end_ix":3236,"citation_format_type":"tether_v4","metadata":{"type":"webpage","title":"GitHub - shadcn-ui/ui: Composable, accessible components with thoughtful defaults. Build your own component library with code you can customize, extend, and make your own. · GitHub","url":"https://github.com/shadcn-ui/ui#:~:text=License","text":"License","pub_date":null,"extra":{"cited_message_idx":29,"cited_message_id":"9d82e461-fb5b-43d5-9daa-459ca4a5a816","search_result_idx":null,"evidence_text":"","start_line_num":230,"end_line_num":232,"connector_source":null},"og_tags":null}},{"start_ix":3455,"end_ix":3469,"citation_format_type":"tether_v4","metadata":{"type":"webpage","title":"GitHub - shadcn-ui/ui: Composable, accessible components with thoughtful defaults. Build your own component library with code you can customize, extend, and make your own. · GitHub","url":"https://github.com/shadcn-ui/ui#:~:text=License","text":"License","pub_date":null,"extra":{"cited_message_idx":29,"cited_message_id":"9d82e461-fb5b-43d5-9daa-459ca4a5a816","search_result_idx":null,"evidence_text":"","start_line_num":230,"end_line_num":232,"connector_source":null},"og_tags":null}},{"start_ix":3524,"end_ix":3538,"citation_format_type":"tether_v4","metadata":{"type":"webpage","title":"GitHub - saadeghi/daisyui: 🌼 🌼 🌼 🌼 🌼  The most popular, free and open-source Tailwind CSS component library · GitHub","url":"https://github.com/saadeghi/daisyui#:~:text=About","text":"About","pub_date":null,"extra":{"cited_message_idx":38,"cited_message_id":"4eb27bf5-fb97-41f9-89b8-d2a4de71b59f","search_result_idx":null,"evidence_text":"","start_line_num":219,"end_line_num":223,"connector_source":null},"og_tags":null}},{"start_ix":3576,"end_ix":3590,"citation_format_type":"tether_v4","metadata":{"type":"webpage","title":"GitHub - saadeghi/daisyui: 🌼 🌼 🌼 🌼 🌼  The most popular, free and open-source Tailwind CSS component library · GitHub","url":"https://github.com/saadeghi/daisyui#:~:text=About","text":"About","pub_date":null,"extra":{"cited_message_idx":38,"cited_message_id":"4eb27bf5-fb97-41f9-89b8-d2a4de71b59f","search_result_idx":null,"evidence_text":"","start_line_num":219,"end_line_num":223,"connector_source":null},"og_tags":null}},{"start_ix":3901,"end_ix":3915,"citation_format_type":"tether_v4","metadata":{"type":"webpage","title":"Chat - Semi Design","url":"https://semi.design/en-US/plus/chat#:~:text=%27assistant%27%2C%20id%3A%20%273%27%2C%20createAt%3A%201715676751919%2C,CN%2Fstart%2Fintroduction%29%E3%80%82%20Semi%20Design%20features","text":"'assistant', id: '3', createAt: 1715676751919, content: ` Semi Design is a design system designed, developed and maintained by Douyin's front-end team and MED product design team. As a comprehensive, easy-to-use, high-quality modern application UI solution, Semi Design is extracted from the complex scenarios of ByteDance's various business lines. It has currently supported nearly a thousand platform products and served more than 100,000 internal and external users.[[1]](https://semi.design/zh-CN/start/introduction)。 Semi Design features","pub_date":null,"extra":{"cited_message_idx":44,"cited_message_id":"fa39685d-e423-419c-b810-db17bec2edd7","search_result_idx":null,"evidence_text":"","start_line_num":152,"end_line_num":158,"connector_source":null},"og_tags":null}},{"start_ix":3955,"end_ix":3969,"citation_format_type":"tether_v4","metadata":{"type":"webpage","title":"Chat - Semi Design","url":"https://semi.design/en-US/plus/chat#:~:text=%27assistant%27%2C%20id%3A%20%273%27%2C%20createAt%3A%201715676751919%2C,CN%2Fstart%2Fintroduction%29%E3%80%82%20Semi%20Design%20features","text":"'assistant', id: '3', createAt: 1715676751919, content: ` Semi Design is a design system designed, developed and maintained by Douyin's front-end team and MED product design team. As a comprehensive, easy-to-use, high-quality modern application UI solution, Semi Design is extracted from the complex scenarios of ByteDance's various business lines. It has currently supported nearly a thousand platform products and served more than 100,000 internal and external users.[[1]](https://semi.design/zh-CN/start/introduction)。 Semi Design features","pub_date":null,"extra":{"cited_message_idx":44,"cited_message_id":"fa39685d-e423-419c-b810-db17bec2edd7","search_result_idx":null,"evidence_text":"","start_line_num":152,"end_line_num":158,"connector_source":null},"og_tags":null}},{"start_ix":7043,"end_ix":7059,"citation_format_type":"tether_v4","metadata":{"type":"image_inline","asset_pointer_links":[],"clicked_from_url":null,"clicked_from_title":null}},{"start_ix":9488,"end_ix":9500,"citation_format_type":"tether_v4","metadata":{"type":"webpage","title":"GitHub - DTALEX66/ArcheAxis-Knowledge-OS: 星环知识平台 ArcheAxis Knowledge — local-first, evidence-driven, bidirectional Human-AI Learning & Trusted-Knowledge Workspace. NOT an Agent OS. Absorbed: JiWER/RapidFuzz/JSONCanvas/FSRS/Magika/Connectors. Blocked (external): MinerU/Marker/PyMuPDF4LLM/FunASR/tldraw/Firecrawl/H5P/Phoenix/SearXNG. Deps: docs/environment/EXTERNAL_DEPENDENCIES.md · GitHub","url":"https://github.com/DTALEX66/ArcheAxis-Knowledge-OS#:~:text=,Avalonia%20%E5%8E%9F%E7%94%9F