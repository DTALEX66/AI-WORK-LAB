<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>AAOS｜学习平台与知识库软件扩展调研</title><style>
:root{--ink:#19212e;--muted:#59657a;--paper:#fff;--bg:#f2f5f9;--line:#dce3ec;--accent:#007f89;--violet:#6c4de6;--blue:#1972cb;--pink:#c5438d}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.75 system-ui,-apple-system,"Segoe UI","Microsoft YaHei","Noto Sans CJK SC",sans-serif}a{color:#087989;text-decoration:none}a:hover{text-decoration:underline}a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible{outline:3px solid #1595b3;outline-offset:3px}button,input,select{font:inherit}button{cursor:pointer}header{background:#0d1119;color:#f4f7ff;padding:58px max(30px,calc((100vw - 1240px)/2));position:relative;overflow:hidden}header:after{content:"";position:absolute;bottom:0;left:0;right:0;height:4px;background:linear-gradient(90deg,#12bbcd,#f556ab,#44d47e,#576dff)}.eyebrow{text-transform:uppercase;letter-spacing:.13em;font-size:12px;color:#9fcdd8}h1{font-size:clamp(30px,4vw,48px);line-height:1.25;letter-spacing:-.03em;margin:16px 0}header p{max-width:850px;color:#b7c4d5;margin:15px 0}header .meta{font-size:13px}.page{max-width:1510px;margin:0 auto;display:grid;grid-template-columns:210px minmax(0,1fr);gap:32px;padding:34px}.toc{position:sticky;top:18px;align-self:start;font-size:14px;padding:14px 0}.toc a{display:block;padding:7px 12px;border-radius:7px;color:#45536a}.toc a:hover{background:#e5ebf2}.toc strong{display:block;padding:7px 12px;color:#172635}.toc .tiny{padding:16px 12px}.tiny,.caption{font-size:13px;color:var(--muted)}main{min-width:0}.section{margin-bottom:28px;padding:30px 34px;background:var(--paper);border:1px solid var(--line);border-radius:14px;scroll-margin-top:20px}h2{margin:0 0 18px;font-size:25px;line-height:1.4;letter-spacing:-.02em}h3{font-size:19px;margin:23px 0 10px;line-height:1.5}p{margin:10px 0}ul,ol{padding-left:23px}li{margin:6px 0}.lead{font-size:19px;line-height:1.75}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin:24px 0}.stat{padding:19px;border-radius:13px;color:white;background:linear-gradient(135deg,#0a708c,#10bdc0)}.stat:nth-child(2){background:linear-gradient(135deg,#9c3c9d,#ea6899)}.stat:nth-child(3){background:linear-gradient(135deg,#147f73,#33b96b)}.stat:nth-child(4){background:linear-gradient(135deg,#5149a3,#237ec7)}.stat strong{display:block;font-size:31px;line-height:1.3}.stat span{font-size:13px}.notice{background:#eef7f9;border-left:4px solid #0b9299;padding:14px 18px;margin:18px 0;border-radius:0 9px 9px 0}.warn{background:#fff8e9;border-color:#ca9832}.badge{display:inline-block;padding:2px 8px;background:#edf2f8;border-radius:5px;font-size:12px;line-height:1.7;white-space:normal}.badge.good{background:#e4f3ee;color:#14664f}.badge.pending{background:#fff0df;color:#8f550c}.badge.focus{background:#efeaff;color:#6140b3}.citations{display:inline-flex;gap:4px;flex-wrap:wrap;margin-left:5px;font-size:12px;vertical-align:baseline}.table-wrap{overflow:auto;margin:16px 0 8px}table{border-collapse:collapse;width:100%;font-size:14px;line-height:1.65;text-align:left}th{background:#f0f4f8;color:#43506a;position:sticky;top:0;font-weight:600;white-space:nowrap}th,td{padding:12px 13px;border-bottom:1px solid var(--line);vertical-align:top}tbody tr:hover{background:#f9fbfd}.catalog td:first-child{min-width:175px}.catalog td:nth-child(2){min-width:210px}.catalog td:nth-child(3){min-width:250px}.filters{display:flex;flex-wrap:wrap;gap:10px;padding:16px;background:#f1f5f8;border-radius:10px;margin:18px 0}.filters input[type=search]{flex:1;min-width:220px}.filters input,.filters select{padding:9px 11px;border:1px solid #cbd6e2;border-radius:7px;background:white;color:var(--ink);max-width:100%}.filters label{display:flex;gap:7px;align-items:center;font-size:14px}.filters button,.actions button{border:1px solid #bed0dc;color:#20576c;background:white;padding:8px 12px;border-radius:7px}.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:15px}.actions .primary{background:#057e8e;color:white;border-color:#057e8e}.focus-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.focus-card{border:1px solid var(--line);border-radius:10px;padding:20px}.focus-card h3{margin:0 0 10px;color:#13445c}.focus-card .kicker{font-size:12px;text-transform:uppercase;color:#68788e}.focus-card p{font-size:14px}.focus-card strong{font-weight:650}details{margin:9px 0}summary{cursor:pointer;color:#29647a;font-size:14px}details p{font-size:14px;color:#4f6076}.principles{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px}.principle{padding:18px;background:#f5f8fb;border-radius:9px}.principle h3{font-size:17px;margin:0 0 8px}.principle p{font-size:14px}.scheme-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:17px}.scheme{border:1px solid var(--line);border-radius:10px;padding:18px}.scheme h3{margin:0 0 10px;font-size:17px}.schematic{height:165px;border:1px solid #b9c7d6;border-radius:8px;background:#e9eef5;padding:7px;display:flex;flex-direction:column;gap:6px}.mini-top{height:17px;border-radius:4px;background:#d1dce8;font-size:8px;padding:0 7px;color:#52677c;display:flex;justify-content:space-between}.mini-body{display:grid;gap:6px;flex:1;min-height:0}.mini{border-radius:5px;background:#fdfefe;padding:8px;font-size:10px;color:#586c80;border:1px solid #dae2ed}.mini-main{background:#fff;border-color:#a7c3ce;color:#21576b}.mini-main:after{content:"";display:block;height:48%;margin-top:9px;background:repeating-linear-gradient(to bottom,#dbe5ec 0 3px,transparent 3px 11px);opacity:.8}.mini-side{background:#dde8ef}.mini-canvas{background-color:#fcfefe;background-image:radial-gradient(#c7d4dd 1px,transparent 1px);background-size:10px 10px;position:relative}.mini-canvas span{position:absolute;display:block;padding:5px;background:#d9f1ed;border:1px solid #80bfb3;border-radius:4px;font-size:9px}.mini-canvas span:nth-child(1){left:10%;top:15%}.mini-canvas span:nth-child(2){right:10%;top:37%;background:#e9e1fc;border-color:#b5a0d2}.mini-canvas span:nth-child(3){left:16%;bottom:9%;background:#fde9ef;border-color:#d8a4b6}.mini-bottom{height:16px;width:60%;background:#ccd9e6;border-radius:9px;margin:auto}.source-list{font-size:13px;list-style:none;padding:0}.source-list li{padding:12px 0;border-bottom:1px solid var(--line);overflow-wrap:anywhere}.source-id{font:600 12px ui-monospace,monospace;color:#587086}.source-url{display:block;color:#507585;font-size:12px}.stage-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:13px}.stage{background:#f1f6f9;padding:17px;border-radius:9px}.stage h3{margin:0 0 8px;font-size:17px}.stage p{font-size:14px}.download-note{font-size:12px;color:#607188}.hidden,[hidden]{display:none!important}pre{white-space:pre-wrap;overflow-wrap:anywhere;background:#101924;color:#d7e8f3;padding:22px;border-radius:10px;font:14px/1.75 ui-monospace,"Microsoft YaHei",monospace}.break{word-break:break-word}footer{color:#67788b;font-size:13px;text-align:center;padding:20px 30px 40px}.zero{padding:18px;color:#775a20;background:#fff7e7;border-radius:8px}.floating-top{position:fixed;bottom:20px;right:18px;padding:8px 12px;background:#fff;border:1px solid #bdccd9;border-radius:8px;font-size:13px;box-shadow:0 4px 15px #001d3820}.report-title{font-size:13px;color:#61758b}.compact{font-size:14px}code{background:#eef1f5;padding:2px 5px;border-radius:3px;font-size:.92em}.soft{color:#68788e}
@media(max-width:1080px){.page{grid-template-columns:1fr;padding:20px;gap:12px}.toc{position:static;display:flex;flex-wrap:wrap;padding:0}.toc a{font-size:13px}.toc .tiny,.toc strong{display:none}.section{padding:24px}.stats{gap:10px}.stat{padding:15px}}@media(max-width:680px){header{padding:32px 23px}.page{padding:12px}.section{padding:21px 18px;border-radius:10px}.stats,.focus-grid,.principles,.scheme-grid,.stage-grid{grid-template-columns:1fr}.stats{grid-template-columns:repeat(2,1fr)}h2{font-size:22px}.lead{font-size:17px}}
@media print{body{background:white;font-size:11px;line-height:1.6}.page{display:block;padding:0;max-width:none}.toc,.filters,.actions,.floating-top,.download-note{display:none!important}header{padding:22px;color:#152337;background:white;border-bottom:3px solid #0a8a97}header p{color:#536375}h1{font-size:27px}.section{padding:20px 0;border:0;border-radius:0;break-inside:auto}h2{font-size:20px;break-after:avoid}h3{break-after:avoid}.focus-card,.scheme,.principle,.stage,tr{break-inside:avoid}.focus-card{padding:12px}.stats{gap:9px}.stat{color:#173f52;background:#eaf3f7!important;padding:12px}.table-wrap{overflow:visible}table{font-size:10px}td,th{padding:7px}.citations{font-size:9px}.source-list{font-size:10px}details:not([open])>*:not(summary){display:block}.catalog td{min-width:0!important}pre{background:#f1f4f7;color:#22394c;font-size:10px}.caption{font-size:10px}}
</style></head><body id="top"><header><div class="eyebrow">ArcheAxis Knowledge OS · Research</div><h1>学习平台与知识库软件<br>扩展调研与融合建议</h1><p>从资料进入、理解与组织，到独立练习、反馈、复习和表达。研究复杂能力怎样共同工作，并回到 AAOS 的现有框架。</p><div class="meta">2026-10-30 · Asia/Shanghai · 公开资料研究 · 设计与接入建议</div></header><div class="page"><nav class="toc" aria-label="报告目录"><strong>报告目录</strong><a href="#summary">结论与范围</a><a href="#landscape">八类产品</a><a href="#principles">融合原则</a><a href="#layouts">六种工作现场</a><a href="#focus">16个重点对象</a><a href="#catalog">100项对照表</a><a href="#exchange">格式与互通</a><a href="#reuse">复用与依赖</a><a href="#retrieval">公共检索</a><a href="#mapping">186项关联映射</a><a href="#roadmap">落地顺序</a><a href="#stitch">STITCH研究补充</a><a href="#sources">来源与限制</a><div class="tiny">按问题筛选产品；先读重点对象，再查完整目录。所有适配优先级均为本报告判断。</div></nav><main><section class="section" id="summary"><div class="report-title">01 / 结论与范围</div><h2>采用可组合的学习与知识工作区</h2><p class="lead">AAOS 可以同时拥有深度阅读、空间思考、研究核验和学习练习。共用对象与来源，在当前任务中显示合适工具，是比照搬某个产品整套界面更适合现有工程的方向。</p><div class="stats"><div class="stat"><strong>100</strong><span>纳入目录的产品与平台</span></div><div class="stat"><strong>8</strong><span>调研赛道</span></div><div class="stat"><strong>16</strong><span>重点借鉴对象</span></div><div class="stat"><strong>186</strong><span>原始能力意图保留映射</span></div></div><p>证据分层：89项取得官方功能资料；5项目前仅入口确认；6项仍为候选。官方资料中，文档确认22项、产品页确认62项、仓库确认2项、官方检索确认3项。完整目录可以按证据级别筛选。</p><div class="notice"><strong>边界：</strong>这是截至本次日期的公开资料横向研究，覆盖100个代表对象，并非全球软件穷尽调查。功能确认指官方资料有相应描述；未登录试用、未购买服务、未运行其API、未验证导入导出，也未将这些能力接入AAOS。</div><p><strong>本轮最重要的变化：</strong>从“给单页减内容”转为“为不同任务安排工作现场”。专业工作区可以三栏甚至更多面板，但每个区域要有稳定职责、足够宽度和可返回的对象关系。保留已认可的丰富渐变与玻璃质感，阅读和作答区域维持稳定排版。</p><p>当前五入口继续保留：<strong>工作台 / 资料与知识 / 研究与比较 / 学习与表达 / AI助手</strong>。资源中心、系统中心、全局任务和小栖保持工具入口。企业组织、教务、班级和团队权限不进入本期；相关产品中可用于个人的内容组织方式仍可借鉴。</p></section><section class="section" id="landscape"><div class="report-title">02 / 调研版图</div><h2>八类产品承担不同问题</h2><div class="table-wrap"><table class=""><thead><tr><th>赛道</th><th>对象数</th><th>主要问题</th></tr></thead><tbody><tr><td>个人知识库与结构化笔记</td><td>24</td><td>如何捕获、写作、关联、建立集合，并保有数据。</td></tr><tr><td>视觉思考与画布</td><td>5</td><td>如何把资料、概念和表达放在空间中组织。</td></tr><tr><td>阅读批注与文献管理</td><td>11</td><td>如何阅读多格式原件、摘录、引用并回到来源。</td></tr><tr><td>记忆复习与AI学习</td><td>11</td><td>如何把材料转为练习，记录反馈并安排复习。</td></tr><tr><td>课程与学习平台</td><td>15</td><td>如何组织课程、目标、活动、项目和学习路径。</td></tr><tr><td>交互练习与实作</td><td>8</td><td>如何让学习者操作、作答、试错和接受反馈。</td></tr><tr><td>AI研究与证据发现</td><td>9</td><td>如何确定材料范围、找文献、核验主张与整理证据。</td></tr><tr><td>国内笔记与学习入口</td><td>17</td><td>如何适应中文材料、国内课程发现与常用知识工具。</td></tr></tbody></table></div><p class="caption">分类用于本报告索引，不是建议AAOS增加八个一级导航。一个对象只计入一个主类，跨类用途通过建议说明。</p><h3>容易被旧资料混淆的当前情况</h3><ul><li>Google官方在2026年7月说明NotebookLM更名为Gemini Notebook；本报告保留旧名便于识别。<span class="citations"><a href="#src-S149">[S149]</a></span></li><li>Tana的会议平台与Tana Outliner分别存在；本轮知识库研究指Outliner。<span class="citations"><a href="#src-S014">[S014]</a><a href="#src-S019">[S019]</a></span></li><li>Nebo官网当前跳转到MyScript Notes。<span class="citations"><a href="#src-S056">[S056]</a></span></li><li>Logseq当前仓库区分DB图谱及其测试状态，迁移方案不能只沿用旧文件图谱假设。<span class="citations"><a href="#src-S091">[S091]</a></span></li><li>MarginNote官网首页有简化演示动画，本报告的任务模板结论还核对了单独功能文档，避免将宣传动画当作实际交互验收。<span class="citations"><a href="#src-S134">[S134]</a><a href="#src-S135">[S135]</a></span></li></ul></section><section class="section" id="principles"><div class="report-title">03 / 融合原则</div><h2>八条可迁移的产品规则</h2><p>以下是根据官方资料和AAOS约束形成的设计判断，不是对产品学习效果的实测排名。</p><div class="principles"><article class="principle"><h3>01 · 按任务安排工具，允许自由组合</h3><p>阅读、摘录、组织、作答和研究使用不同起始配方；用户仍可停靠、分栏、浮动、固定与保存布局。配方只改变工具组合，不自动联网或执行模型。 <span class="citations"><a href="#src-S135">[S135]</a><a href="#src-S006">[S006]</a></span></p></article><article class="principle"><h3>02 · 同一内容，多种视图</h3><p>笔记、卡片、图谱、表格和画布优先引用同一对象。关联不是重复复制；关闭视图不删除内容或取消任务。 <span class="citations"><a href="#src-S133">[S133]</a><a href="#src-S005">[S005]</a><a href="#src-S135">[S135]</a></span></p></article><article class="principle"><h3>03 · 来源与版本是学习产物的骨架</h3><p>摘录、知识点、题目、纠正与结论保留来源对象、版本和页码/区域/时间位置；原件变更后可识别哪些产物需要回查。 <span class="citations"><a href="#src-S010">[S010]</a><a href="#src-S008">[S008]</a></span></p></article><article class="principle"><h3>04 · 把作答、解释与评价分开</h3><p>练习先让学习者独立作答，再给提示、答案、解释与复测。自评、AI评价、回忆预测和独立测试记录分别呈现。 <span class="citations"><a href="#src-S063">[S063]</a><a href="#src-S098">[S098]</a><a href="#src-S070">[S070]</a></span></p></article><article class="principle"><h3>05 · 关系需要类型和依据</h3><p>引用、双链、相似、支持、反对与用户绘制连线使用不同语义。相似文献图和空间邻近不能冒充事实关系。 <span class="citations"><a href="#src-S103">[S103]</a><a href="#src-S041">[S041]</a></span></p></article><article class="principle"><h3>06 · 丰富视觉与稳定操作可以共存</h3><p>保留彩色摘要、资料封面、玻璃边缘和关系探索；正文与练习区采用稳定排版。专业工作区可高密度，区域职责、选中态和快捷操作需一致。 <span class="citations"><a href="#src-S018">[S018]</a><a href="#src-S135">[S135]</a></span></p></article><article class="principle"><h3>07 · 功能接入状态与业务状态分开</h3><p>功能可显示待接入或待开发；资料还要分别标原件保存、提取、校对、检索和导出状态。课程完成、作答成绩与掌握判断分开。 <span class="citations"><a href="#src-S112">[S112]</a><a href="#src-S070">[S070]</a></span></p></article><article class="principle"><h3>08 · 公开访问、格式支持与可复用代码分别判断</h3><p>有官网、能导出或源代码公开，均不足以证明可直接嵌入AAOS。先核对格式语义、具体目录许可证、依赖和真实运行结果。 <span class="citations"><a href="#src-S138">[S138]</a><a href="#src-S132">[S132]</a><a href="#src-S096">[S096]</a></span></p></article></div><div class="notice warn"><strong>四条重要区分：</strong>看完内容与学会不同；回忆预测与理解能力不同；文献相似与引用/支持关系不同；导出文件成功与完整往返不同。</div></section><section class="section" id="layouts"><div class="report-title">04 / 界面组织</div><h2>六种工作现场，共用同一套外壳</h2><p>下面是本报告归纳的结构示意，非产品截图，也不是已经实现的AAOS界面。面板可停靠、浮动、收起或固定；普通窗口以当前任务可读为先。</p><div class="scheme-grid"><article class="scheme"><h3>资料库浏览</h3><div class="schematic"><div class="mini-top"><span>AAOS · 对象与任务</span><span>搜索 / 工具</span></div><div class="mini-body" style="grid-template-columns:1fr 2.7fr 1.1fr"><div class="mini mini-side">目录与集合</div><div class="mini mini-main">资料列表 / 玻璃叠卡</div><div class="mini mini-side">选中详情</div></div><div class="mini-bottom"></div></div><p class="caption">资料可按格式和属性筛选；列表与叠卡共享选择和范围。</p></article><article class="scheme"><h3>持续阅读</h3><div class="schematic"><div class="mini-top"><span>AAOS · 对象与任务</span><span>搜索 / 工具</span></div><div class="mini-body" style="grid-template-columns:0.65fr 3fr 0.65fr"><div class="mini mini-side">目录</div><div class="mini mini-main">正文与图表</div><div class="mini mini-side">批注 / 引用入口</div></div><div class="mini-bottom"></div></div><p class="caption">正文稳定，来源卡就近展开，允许舒适阅读与快速回查。</p></article><article class="scheme"><h3>原件校对</h3><div class="schematic"><div class="mini-top"><span>AAOS · 对象与任务</span><span>搜索 / 工具</span></div><div class="mini-body" style="grid-template-columns:1.2fr 1.45fr"><div class="mini mini-side">原件及对应区域</div><div class="mini mini-main">正文与当前疑点</div></div><div class="mini-bottom"></div></div><p class="caption">双栏是起点，当前疑点用短说明；宽窗可主动固定证据工具。</p></article><article class="scheme"><h3>空间思考</h3><div class="schematic"><div class="mini-top"><span>AAOS · 对象与任务</span><span>搜索 / 工具</span></div><div class="mini-body" style="grid-template-columns:0.7fr 3fr 0.8fr"><div class="mini mini-side">资料来源</div><div class="mini mini-canvas"><span>资料摘录</span><span>待核查主张</span><span>我的判断</span></div><div class="mini mini-side">选中属性</div></div><div class="mini-bottom"></div></div><p class="caption">卡片与连线保留对象引用；选择后打开正文，返回保留视口。</p></article><article class="scheme"><h3>独立练习</h3><div class="schematic"><div class="mini-top"><span>AAOS · 对象与任务</span><span>搜索 / 工具</span></div><div class="mini-body" style="grid-template-columns:0.7fr 3fr 0.9fr"><div class="mini mini-side">目标 / 来源入口</div><div class="mini mini-main">问题与作答</div><div class="mini mini-side">反馈（作答后）</div></div><div class="mini-bottom"></div></div><p class="caption">逐步提示、揭示答案、自评与独立评测分开，助手可关闭。</p></article><article class="scheme"><h3>研究比较</h3><div class="schematic"><div class="mini-top"><span>AAOS · 对象与任务</span><span>搜索 / 工具</span></div><div class="mini-body" style="grid-template-columns:0.9fr 2.4fr 1.1fr"><div class="mini mini-side">来源集合</div><div class="mini mini-main">比较记录 / 证据矩阵</div><div class="mini mini-side">当前来源预览</div></div><div class="mini-bottom"></div></div><p class="caption">问题、材料、支持与反证、判断和未决形成可回查记录。</p></article></div><h3>对当前阅读稿的具体纠偏</h3><ul><li>保留应用菜单、对象Tab与当前工具栏的职责，合并重复标题和状态；元数据与诊断按需打开。</li><li>正文正常字重，当前疑点局部强调；来源说明、图表和建议不必全部使用独立深色卡片。</li><li>三栏允许存在；先确保原件、正文和结果各自可读，小窗将辅助结果改为抽屉或切换。</li><li>Dock复用同一组件，主入口名称完整单行；布局变化不重建文档、草稿和会话。</li><li>玻璃主要承担导航、浮层和选中层次；彩色摘要、封面与关系视图保留表现力。</li></ul></section><section class="section" id="focus"><div class="report-title">05 / 重点对象</div><h2>16个最值得结合AAOS深读的对象</h2><div class="focus-grid"><article class="focus-card"><div class="kicker">Focus 01</div><h3>Obsidian</h3><p><strong>资料确认：</strong>笔记、链接、未链接提及、Canvas、属性视图和工作区是不同用途的入口。工作区保存打开对象与侧栏状态。 <span class="citations"><a href="#src-S004">[S004]</a><a href="#src-S005">[S005]</a><a href="#src-S006">[S006]</a><a href="#src-S007">[S007]</a></span></p><p><strong>AAOS判断：</strong>把关系图、属性表和正文当作同一对象的视图，避免形成平行知识库。</p><p><strong>界面落点：</strong>目录稳定；正文优先；反链随选择出现；图谱与Canvas通过局部视图进入。</p><details><summary>接入边界与未验证项</summary><p>本轮未测试插件和格式往返。复用文件格式与设计模式，不把闭源桌面应用视作可嵌入组件。</p></details></article><article class="focus-card"><div class="kicker">Focus 02</div><h3>思源 SiYuan</h3><p><strong>资料确认：</strong>内容块贯穿长文、引用、大纲和学习功能；官方说明原生文档使用.sy JSON，提供数据库与FSRS闪卡。 <span class="citations"><a href="#src-S003">[S003]</a><a href="#src-S001">[S001]</a><a href="#src-S092">[S092]</a></span></p><p><strong>AAOS判断：</strong>段落可成为引用和练习来源，但文档、原件和块需要各自稳定身份。</p><p><strong>界面落点：</strong>默认文档阅读；按需聚焦块；属性、反链和学习动作就近出现。</p><details><summary>接入边界与未验证项</summary><p>AGPL-3.0。不能用Markdown导出成功替代块、数据库、附件和历史的完整迁移验收。</p></details></article><article class="focus-card"><div class="kicker">Focus 03</div><h3>Anytype</h3><p><strong>资料确认：</strong>官方文档明确本地优先、离线访问和个人空间，强调数据归属。 <span class="citations"><a href="#src-S020">[S020]</a></span></p><p><strong>AAOS判断：</strong>优先保证本地打开、编辑和查找；联网能力作为可见的附加操作。</p><p><strong>界面落点：</strong>对象属性和类型有稳定位置；云端不可用时仍保留个人资料访问。</p><details><summary>接入边界与未验证项</summary><p>官方架构描述不是本轮安全验证结果；导出、同步和各组件许可证需要另行核查。</p></details></article><article class="focus-card"><div class="kicker">Focus 04</div><h3>Capacities</h3><p><strong>资料确认：</strong>产品以连接的对象组织知识，并提供研究、个人知识与视觉笔记等使用入口。 <span class="citations"><a href="#src-S013">[S013]</a></span></p><p><strong>AAOS判断：</strong>资料、概念、问题和作品可以有不同属性模板，共用引用和检索。</p><p><strong>界面落点：</strong>按对象类型筛选，详情只显示当前类型有用的字段。</p><details><summary>接入边界与未验证项</summary><p>对象模式为设计借鉴；未验证其API、离线完整范围和导出保真。</p></details></article><article class="focus-card"><div class="kicker">Focus 05</div><h3>Heptabase</h3><p><strong>资料确认：</strong>官方页面将卡片、白板、双链、PDF批注和多来源材料放在同一知识空间。 <span class="citations"><a href="#src-S018">[S018]</a></span></p><p><strong>AAOS判断：</strong>视觉画布应组织可打开、可回查的真实资料；不必强迫所有任务使用图谱。</p><p><strong>界面落点：</strong>研究现场以白板为主；选中卡片再开正文或属性；保持空间位置和返回路径。</p><details><summary>接入边界与未验证项</summary><p>AI、同步与离线是分别核验的能力；图中邻近和连接必须保留不同语义。</p></details></article><article class="focus-card"><div class="kicker">Focus 06</div><h3>Zotero</h3><p><strong>资料确认：</strong>批注可加入笔记，并保留返回PDF页的链接与引文信息。 <span class="citations"><a href="#src-S010">[S010]</a></span></p><p><strong>AAOS判断：</strong>优先实现摘录到原件的回跳，来源链比大面积诊断卡更直接。</p><p><strong>界面落点：</strong>原件、批注列表和笔记各有职责；引用详情在阅读现场短暂展开。</p><details><summary>接入边界与未验证项</summary><p>内部批注与PDF文件内批注要分开验证。本轮未进行导出、回导或跨软件迁移。</p></details></article><article class="focus-card"><div class="kicker">Focus 07</div><h3>Readwise Reader</h3><p><strong>资料确认：</strong>将网页、RSS、PDF、EPUB和视频转录纳入阅读与高亮流程。 <span class="citations"><a href="#src-S011">[S011]</a></span></p><p><strong>AAOS判断：</strong>多格式入口先统一收集和待处理队列，正文仍采用适合各格式的阅读方式。</p><p><strong>界面落点：</strong>收件箱与阅读分开；打开资料后突出正文，高亮和笔记按需出现。</p><details><summary>接入边界与未验证项</summary><p>多格式收集不等于每种格式都能编辑；服务订阅、离线与导出需按操作核验。</p></details></article><article class="focus-card"><div class="kicker">Focus 08</div><h3>MarginNote</h3><p><strong>资料确认：</strong>当前官方模板文档说明：同一摘录卡可以出现在原件、导图与复习中；工具按任务模式配置，可保留传统界面。 <span class="citations"><a href="#src-S135">[S135]</a><a href="#src-S134">[S134]</a></span></p><p><strong>AAOS判断：</strong>采用任务配方加自由调整，保持同一对象身份；减少首屏工具同时显现，不删能力。</p><p><strong>界面落点：</strong>摘录、组织、回忆使用不同工具组合；资料和笔记持续保留。</p><details><summary>接入边界与未验证项</summary><p>这是苹果平台产品的公开设计资料。本轮未安装试用，也未验证Windows接入或导出。</p></details></article><article class="focus-card"><div class="kicker">Focus 09</div><h3>LiquidText</h3><p><strong>资料确认：</strong>围绕跨文档摘录、注释、相互连接与原上下文回查建立研究空间。 <span class="citations"><a href="#src-S012">[S012]</a></span></p><p><strong>AAOS判断：</strong>证据摘录与研究结论分开，用户可以把多个来源放在一起比较。</p><p><strong>界面落点：</strong>原件与证据工作区可并排；选中摘录时定位来源，关闭辅助区后归还空间。</p><details><summary>接入边界与未验证项</summary><p>证据连线只表示用户建立的联系；不自动代表因果、支持或事实正确。</p></details></article><article class="focus-card"><div class="kicker">Focus 10</div><h3>Anki</h3><p><strong>资料确认：</strong>卡片支持问答、挖空和图像遮挡；FSRS用于安排复习。调度选项包含保留率与工作量取舍。 <span class="citations"><a href="#src-S063">[S063]</a><a href="#src-S066">[S066]</a><a href="#src-S067">[S067]</a></span></p><p><strong>AAOS判断：</strong>练习应先独立作答，再揭示答案、反馈和安排复习；回忆预测与理解证据分别记录。</p><p><strong>界面落点：</strong>练习现场突出一个问题与作答区域；详细调度参数进入设置。</p><details><summary>接入边界与未验证项</summary><p>卡片正文、模板、媒体、学习事件和调度状态是不同迁移对象。不要让前后端维护两份复习真值。</p></details></article><article class="focus-card"><div class="kicker">Focus 11</div><h3>RemNote</h3><p><strong>资料确认：</strong>Reader批注可连接笔记与闪卡，卡片有多种题型；官方说明了Anki导入和导出范围。 <span class="citations"><a href="#src-S008">[S008]</a><a href="#src-S009">[S009]</a><a href="#src-S140">[S140]</a><a href="#src-S141">[S141]</a></span></p><p><strong>AAOS判断：</strong>让材料、摘录、知识点与练习互相可追溯，避免再建一套脱离资料的题库。</p><p><strong>界面落点：</strong>阅读时就近创建学习卡，复习时切换为问题与作答；二者共享来源。</p><details><summary>接入边界与未验证项</summary><p>Reader部分能力属于付费服务；Anki导出仅涵盖卡片；原生完整导出对媒体另有说明。</p></details></article><article class="focus-card"><div class="kicker">Focus 12</div><h3>SuperMemo Desktop</h3><p><strong>资料确认：</strong>增量阅读把导入、阅读、摘录、提问和复习组织为持续过程，允许材料分批消化。 <span class="citations"><a href="#src-S110">[S110]</a></span></p><p><strong>AAOS判断：</strong>工作台需要今日可处理的资料和复习队列，不必把全部资料一次读完。</p><p><strong>界面落点：</strong>每个材料保留阅读位置、下一步与延期处理入口。</p><details><summary>接入边界与未验证项</summary><p>仅借鉴增量处理思想，避免将其完整复杂控制面板搬入默认阅读页；与语言课程产品区别记录。</p></details></article><article class="focus-card"><div class="kicker">Focus 13</div><h3>Khan Academy</h3><p><strong>资料确认：</strong>官方掌握度说明区分课程、单元和技能层级，并通过练习、测验和挑战形成状态。 <span class="citations"><a href="#src-S070">[S070]</a><a href="#src-S071">[S071]</a></span></p><p><strong>AAOS判断：</strong>学习路径应关联先修与具体练习，完成活动和能力判断使用不同依据。</p><p><strong>界面落点：</strong>下一步任务明确；技能状态可下钻到作答记录与反馈。</p><details><summary>接入边界与未验证项</summary><p>其内部积分与掌握规则不可当作跨学科通用证明；AAOS应说明判断来源和局限。</p></details></article><article class="focus-card"><div class="kicker">Focus 14</div><h3>Moodle</h3><p><strong>资料确认：</strong>活动完成条件可包括查看、成绩或手工标记；测验作为独立活动管理。 <span class="citations"><a href="#src-S112">[S112]</a><a href="#src-S113">[S113]</a></span></p><p><strong>AAOS判断：</strong>浏览、完成、成绩与掌握度建立独立状态，允许学习者保存未完成作答。</p><p><strong>界面落点：</strong>课程—活动—作答—反馈逐层进入，当前现场不同时展示所有层级设置。</p><details><summary>接入边界与未验证项</summary><p>只吸收个人课程与练习设计，不引入学校组织、班级和企业培训管理。</p></details></article><article class="focus-card"><div class="kicker">Focus 15</div><h3>Gemini Notebook（原NotebookLM）</h3><p><strong>资料确认：</strong>Google官方2026年7月公告确认更名；当前帮助涵盖来源选择、引文回查、闪卡和测验。 <span class="citations"><a href="#src-S149">[S149]</a><a href="#src-S068">[S068]</a><a href="#src-S069">[S069]</a></span></p><p><strong>AAOS判断：</strong>来源、会话和产物应分工；用户先确定材料范围，再生成有依据的学习内容。</p><p><strong>界面落点：</strong>资料来源、当前工作区与学习产物可独立展开；返回引用时保留任务位置。</p><details><summary>接入边界与未验证项</summary><p>云端生成、代码执行和服务配额不移作AAOS已有能力；本地材料外发仍遵守明确授权。</p></details></article><article class="focus-card"><div class="kicker">Focus 16</div><h3>Elicit</h3><p><strong>资料确认：</strong>从研究问题组织检索、研究报告和数据提取任务，强调带来源的输出。 <span class="citations"><a href="#src-S037">[S037]</a></span></p><p><strong>AAOS判断：</strong>研究比较应形成有字段和来源的证据矩阵，保留人工判断与未决问题。</p><p><strong>界面落点：</strong>问题与范围在上，比较记录在中，选中单元格后查看证据来源。</p><details><summary>接入边界与未验证项</summary><p>供应商案例准确率不是AAOS置信度，也不能替代具体来源与当前版本核验。</p></details></article></div></section><section class="section" id="catalog"><div class="report-title">06 / 产品对照</div><h2>100项可检索目录</h2><p>“已确认”仅指公开资料层面。界面模式和AAOS落点为本报告判断；候选项不参与功能确认数量。</p><div class="filters"><input id="product-q" type="search" aria-label="搜索产品、能力与建议" placeholder="搜索产品、双链、PDF、复习、图谱…"><select id="product-cat" aria-label="按类别筛选"><option value="">全部类别</option><option>个人知识库与结构化笔记</option><option>视觉思考与画布</option><option>阅读批注与文献管理</option><option>记忆复习与AI学习</option><option>课程与学习平台</option><option>交互练习与实作</option><option>AI研究与证据发现</option><option>国内笔记与学习入口</option></select><select id="product-evidence" aria-label="按证据深度筛选"><option value="">全部证据层级</option><option>文档确认</option><option>产品页确认</option><option>入口确认</option><option>候选待核实</option><option>仓库确认</option><option>官方检索确认</option></select><label><input id="product-focus" type="checkbox">仅16个重点对象</label><button id="reset-products" type="button">重置</button></div><p id="product-count" class="caption" aria-live="polite">显示100 / 100项</p><div id="product-zero" class="zero" hidden>没有匹配项。可以清空关键词或调整筛选。</div><div class="table-wrap"><table class="catalog"><thead><tr><th>对象与类别</th><th>公开资料确认范围</th><th>AAOS建议与边界</th></tr></thead><tbody><tr data-product-row data-id="1" data-search="obsidian 个人知识库与结构化笔记 双链、未链接提及、canvas、属性视图与工作区 同一笔记在编辑、关系和集合视图间切换 资料与知识：双链、属性、布局保存 块引用与插件语法需单独迁移测试" data-cat="个人知识库与结构化笔记" data-evidence="文档确认" data-focus="true"><td><strong>Obsidian</strong><br><span class="caption">个人知识库与结构化笔记</span><br><span class="badge focus">重点对象</span></td><td>双链、未链接提及、Canvas、属性视图与工作区<br><span class="badge good">文档确认</span> <span class="citations"><a href="#src-S004">[S004]</a><a href="#src-S005">[S005]</a><a href="#src-S006">[S006]</a><a href="#src-S007">[S007]</a></span></td><td>资料与知识：双链、属性、布局保存<details><summary>组织方式与边界</summary><p><strong>组织：</strong>同一笔记在编辑、关系和集合视图间切换</p><p><strong>边界：</strong>块引用与插件语法需单独迁移测试</p><p>研究建议；AAOS接入未在本轮核验</p></details></td></tr><tr data-product-row data-id="2" data-search="logseq 个人知识库与结构化笔记 大纲、块引用、查询；当前仓库另有db图谱版本说明 日记入口与块级聚焦；版本差异单列 资料与知识：大纲和引用 文件图谱与db图谱不能视作同一交换格式" data-cat="个人知识库与结构化笔记" data-evidence="文档确认" data-focus="false"><td><strong>Logseq</strong><br><span class="caption">个人知识库与结构化笔记</span><br></td><td>大纲、块引用、查询；当前仓库另有DB图谱版本说明<br><span class="badge good">文档确认</span> <span class="citations"><a href="#src-S002">[S002]</a><a href="#src-S091">[S091]</a></span></td><td>资料与知识：大纲和引用<details><summary>组织方式与边界</summary><p><strong>组织：</strong>日记入口与块级聚焦；版本差异单列</p><p><strong>边界：</strong>文件图谱与DB图谱不能视作同一交换格式</p><p>研究建议；AAOS接入未在本轮核验</p></details></td></tr><tr data-product-row data-id="3" data-search="思源 siyuan 个人知识库与结构化笔记 内容块、反链、数据库与fsrs闪卡 长文与块级聚焦共用内容身份 资料与知识及学习：块到卡片 原生.sy为json；agpl-3.0；markdown导出需核对语义" data-cat="个人知识库与结构化笔记" data-evidence="文档确认" data-focus="true"><td><strong>思源 SiYuan</strong><br><span class="caption">个人知识库与结构化笔记</span><br><span class="badge focus">重点对象</span></td><td>内容块、反链、数据库与FSRS闪卡<br><span class="badge good">文档确认</span> <span class="citations"><a href="#src-S003">[S003]</a><a href="#src-S001">[S001]</a><a href="#src-S092">[S092]</a></span></td><td>资料与知识及学习：块到卡片<details><summary>组织方式与边界</summary><p><strong>组织：</strong>长文与块级聚焦共用内容身份</p><p><strong>边界：</strong>原生.sy为JSON；AGPL-3.0；Markdown导出需核对语义</p><p>研究建议；AAOS接入未在本轮核验</p></details></td></tr><tr data-product-row data-id="4" data-search="joplin 个人知识库与结构化笔记 多媒体笔记、网页剪藏、markdown与富文本编辑 笔记本、列表、正文的稳定分区 收集与整理：剪藏和附件 跨编辑模式及导出往返尚未实测" data-cat="个人知识库与结构化笔记" data-evidence="产品页确认" data-focus="false"><td><strong>Joplin</strong><br><span class="caption">个人知识库与结构化笔记</span><br></td><td>多媒体笔记、网页剪藏、Markdown与富文本编辑<br><span class="badge good">产品页确认</span> <span class="citations"><a href="#src-S017">[S017]</a></span></td><td>收集与整理：剪藏和附件<details><summary>组织方式与边界</summary><p><strong>组织：</strong>笔记本、列表、正文的稳定分区</p><p><strong>边界：</strong>跨编辑模式及导出往返尚未实测</p><p>研究建议；AAOS接入未在本轮核验</p></details></td></tr><tr data-product-row data-id="5" data-search="triliumnext / trilium 个人知识库与结构化笔记 个人知识库项目入口与当前代码仓库 候选：层级知识组织与复用 资料与知识：待深入验证 本轮未逐项读取功能手册或测试导入" data-cat="个人知识库与结构化笔记" data-evidence="入口确认" data-focus="false