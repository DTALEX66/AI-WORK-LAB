付与版本", "本轮结论": "研究建议；接入待逐项核验"}, {"原能力ID": "CAP-0160", "原能力名称": "可视化与空间学习表征", "原序号": "8", "原文": "可信本地呈现", "主场景": "系统中心", "内部合并组": "S1", "合并动作": "界面与工作区", "关联组_可复用非重复注册": "K2;L2;X1", "原页面兼容映射": "19/01", "共享视图或服务": "偏好、缩放、主题、布局、平台适配", "父族实现声明_不等于细项验收": "not_implemented", "细项后端操作绑定": "待逐项核对；不得按父族声明自动补齐", "细项运行证据": "本轮未执行", "说明": "本轮为呈现归并；细项运行资格未在本轮执行验证。", "调研关联对象": "MarginNote / Obsidian / Heptabase", "调研界面落点": "任务配方、自由组合、布局恢复和缩放", "本轮结论": "研究建议；接入待逐项核验"}, {"原能力ID": "CAP-0160", "原能力名称": "可视化与空间学习表征", "原序号": "9", "原文": "离线文本降级", "主场景": "学习与表达", "内部合并组": "L2", "合并动作": "讲解与表达", "关联组_可复用非重复注册": "L1;L3;K3;X1", "原页面兼容映射": "07/08/09/10/21", "共享视图或服务": "讲解、画布、课件、仿真与空间方式", "父族实现声明_不等于细项验收": "not_implemented", "细项后端操作绑定": "待逐项核对；不得按父族声明自动补齐", "细项运行证据": "本轮未执行", "说明": "本轮为呈现归并；细项运行资格未在本轮执行验证。", "调研关联对象": "Brilliant / Heptabase / Milanote / Domestika / Skillshare", "调研界面落点": "示例、图解、画布、作品交付与版本", "本轮结论": "研究建议；接入待逐项核验"}]}</script><script>
"use strict";
const reportData=JSON.parse(document.getElementById('report-data').textContent);
const productRows=Array.from(document.querySelectorAll('[data-product-row]'));
const mapRows=Array.from(document.querySelectorAll('[data-map-row]'));
const pq=document.getElementById('product-q'),pc=document.getElementById('product-cat'),pe=document.getElementById('product-evidence'),pf=document.getElementById('product-focus');
function productMatch(row,q,cat,evidence,focus){return (!q||row.dataset.search.includes(q))&&(!cat||row.dataset.cat===cat)&&(!evidence||row.dataset.evidence===evidence)&&(!focus||row.dataset.focus==='true');}
function filterProducts(){const q=pq.value.trim().toLocaleLowerCase(),cat=pc.value,ev=pe.value,focus=pf.checked;let count=0;for(const row of productRows){const match=productMatch(row,q,cat,ev,focus);row.hidden=!match;if(match)count++;}document.getElementById('product-count').textContent=`显示${count} / 100项`;document.getElementById('product-zero').hidden=count!==0;}
for(const field of [pq,pc,pe,pf])field.addEventListener('input',filterProducts);
document.getElementById('reset-products').addEventListener('click',()=>{pq.value='';pc.value='';pe.value='';pf.checked=false;filterProducts();});
document.getElementById('map-q').addEventListener('input',event=>{const q=event.target.value.trim().toLocaleLowerCase();let count=0;for(const row of mapRows){const match=!q||row.dataset.search.includes(q);row.hidden=!match;if(match)count++;}document.getElementById('map-count').textContent=`显示${count} / 186项`;});
function downloadJson(data,name){const blob=new Blob([JSON.stringify(data,null,2)],{type:'application/json;charset=utf-8'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);}
document.getElementById('export-products').addEventListener('click',()=>downloadJson(reportData.products,'AAOS_100项产品对照_20261030.json'));
document.getElementById('export-map').addEventListener('click',()=>downloadJson(reportData.mapping,'AAOS_186项能力调研关联_20261030.json'));
</script></body></html>