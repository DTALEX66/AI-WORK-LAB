schema_version: dual-hermes-taskpack/v4
taskpack_id: dual-repository-workflow-open-design-v4
generated_at: '2026-08-05'

repositories:
  workflow:
    local_path: 'D:\All projects\Workflow-assistance'
    github: DTALEX66/Workflow-assistance
    audit_sha: aee5d72c47d05eb88c77c41fdb69c485f6c192ee
  open_design:
    local_path: 'D:\All projects\OPEN-DESIGN-Assistance'
    github: DTALEX66/OPEN-DESIGN-Assistance
    audit_sha: c8212401e891e7c3f0e4a6f36cdb11dbcca24e27

defaults:
  execution_mode: audit_then_implement_locally
  global_single_writer: true
  windows_native_first: true
  live_apply: false
  github_commit: false
  github_push: false
  create_draft_pr: false
  apply_github_ruleset: false
  merge: false
  release: false
  allow_network_research: true
  allow_model_live_smoke: false
  max_review_repair_rounds: 3
  third_party_default: quarantine

forbidden:
  roots:
    - 'E:\'
  reads:
    - credentials
    - auth.json
    - oauth_tokens
    - api_keys
    - cookies
    - private_keys
    - authentication_databases
  mutations_without_explicit_approval:
    - project_external_write
    - live_apply
    - commit
    - push
    - pull_request
    - ruleset
    - merge
    - release

tasks:
  - id: GLOBAL-001
    title: dual repository read-only baseline
    repo: both
    depends_on: []
  - id: GLOBAL-002
    title: write eligibility and concurrency gate
    repo: both
    depends_on: [GLOBAL-001]
  - id: OD-001
    title: remove credential reads and broad permissions
    repo: open_design
    depends_on: [GLOBAL-002]
  - id: OD-002
    title: align documentation with safety behavior
    repo: open_design
    depends_on: [OD-001]
  - id: WA-001
    title: client-neutral product definition
    repo: workflow
    depends_on: [OD-002]
  - id: WA-002
    title: workflow core schemas
    repo: workflow
    depends_on: [WA-001]
